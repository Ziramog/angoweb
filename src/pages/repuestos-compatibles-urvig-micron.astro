---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const title = 'Repuestos compatibles para Urvig y Micron | ANGO Metalúrgica';
const description = 'Repuestos compatibles nacionales para equipos Urvig y Micron. Enviá modelo, medidas o foto y recibí cotización para tomas de fuerza industriales.';
const canonical = 'https://www.angometalurgica.com.ar/repuestos-compatibles-urvig-micron';
const whatsappBase = 'https://wa.me/5493571699006';

const compatibleParts = [
    { urvigCode: 'TAE47A', micronCode: '104134428', description: 'Corona dentada' },
    { urvigCode: 'TAE203B', micronCode: '104334016', description: 'Eje principal toma de fuerza' },
    { urvigCode: 'TAA13A', micronCode: '24300209', description: 'Tuerca de eje principal' },
    { urvigCode: 'TAA10A', micronCode: '103934011', description: 'Conjunto collar de bronce' },
    { urvigCode: 'TAE45A', micronCode: '104134007', description: 'Plato con cubo' },
    { urvigCode: 'TAAD3A', micronCode: '104134005', description: 'Plato liso desplazable' },
    { urvigCode: 'TAE46A', micronCode: '104134026', description: 'Plato liso separador' },
    { urvigCode: 'TBA06A', micronCode: '104134010', description: 'Horquilla de accionamiento' },
    { urvigCode: 'TAA09A', micronCode: '104134013', description: 'Buje accionamiento leva — pata araña' },
    { urvigCode: 'TAA12A', micronCode: '104334118', description: 'Leva aprieta disco' },
    { urvigCode: 'TAA11A', micronCode: '102324120', description: 'Brazo de articulación' },
    { urvigCode: 'TAE44A', micronCode: '98342044506', description: 'Resorte de plato' },
    { urvigCode: 'TAA14B', micronCode: '104334119', description: 'Perno de leva sin cabeza' },
    { urvigCode: 'TAA15B', micronCode: '104334021', description: 'Perno brazo de articulación sin cabeza' }
] as const;

const getPartWhatsAppUrl = (part: typeof compatibleParts[number]) => {
    const message = [
        'Hola ANGO, quiero consultar disponibilidad de este repuesto compatible.',
        '',
        `Repuesto: ${part.description}`,
        `Código Urvig: ${part.urvigCode}`,
        `Equivalente Micron: ${part.micronCode}`,
        'Cantidad:'
    ].join('\n');

    return `${whatsappBase}?text=${encodeURIComponent(message)}`;
};
---

<Layout title={title} description={description} canonical={canonical}>
    <Navbar forceScrolled={true} />

    <main class="compat-page">
        <section class="compat-hero">
            <div class="compat-grid" aria-hidden="true"></div>
            <div class="container compat-hero-inner">
                <div class="compat-hero-copy" data-reveal>
                    <span class="section-kicker">Soluciones compatibles</span>
                    <h1>Repuestos compatibles para Urvig y Micron</h1>
                    <p class="compat-lead">Fabricación nacional de piezas compatibles para reparación y mantenimiento de tomas de fuerza industriales. Enviá modelo, medidas o foto del repuesto y te cotizamos.</p>

                    <div class="compat-hero-actions">
                        <a
                            id="cta-whatsapp-hero"
                            class="btn btn-primary js-track-whatsapp"
                            data-event="whatsapp_clicked"
                            data-location="hero"
                            href={`${whatsappBase}?text=${encodeURIComponent('Hola ANGO, necesito solicitar cotización de un repuesto compatible para una toma de fuerza Urvig/Micron. Puedo enviar modelo, medidas o foto.')}`}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            <i class="ph-bold ph-whatsapp-logo"></i>
                            Solicitar cotización
                        </a>
                        <a class="btn btn-outline" href="#cotizar">
                            <i class="ph-bold ph-camera"></i>
                            Enviar modelo o foto
                        </a>
                    </div>

                    <ul class="compat-proof-list" aria-label="Ventajas del servicio">
                        <li><i class="ph-bold ph-check"></i> Para tomas de fuerza industriales</li>
                        <li><i class="ph-bold ph-check"></i> Fabricación nacional</li>
                        <li><i class="ph-bold ph-check"></i> Envíos a todo el país</li>
                    </ul>
                </div>

                <div class="compat-hero-visual" data-reveal style="--i: 1">
                    <span class="compat-figure-label">FIG. 01 / REPUESTO COMPATIBLE</span>
                    <div class="compat-hero-image-wrap">
                        <img src="/platoconcono_urvig.jpeg" alt="Repuesto compatible nacional para toma de fuerza industrial" class="compat-hero-image" width="900" height="900" decoding="async">
                    </div>
                    <div class="compat-callout compat-callout-model">
                        <span>01</span>
                        <strong>Modelo o placa</strong>
                    </div>
                    <div class="compat-callout compat-callout-photo">
                        <span>02</span>
                        <strong>Foto y medidas</strong>
                    </div>
                    <div class="compat-hero-stamp">
                        <small>ANGO METALÚRGICA</small>
                        <strong>SOLICITAR COTIZACIÓN</strong>
                    </div>
                </div>
            </div>
        </section>

        <section class="compat-band" aria-label="Proceso de consulta">
            <div class="container compat-band-grid">
                <div><span>01</span><strong>Identificamos el modelo</strong></div>
                <div><span>02</span><strong>Revisamos medidas y aplicación</strong></div>
                <div><span>03</span><strong>Cotizamos el repuesto</strong></div>
            </div>
        </section>

        <section class="compat-lines section" id="compatibles">
            <div class="container">
                <div class="compat-section-heading" data-reveal>
                    <div>
                        <span class="section-kicker">Líneas compatibles</span>
                        <h2 class="section-title">Urvig y Micron</h2>
                    </div>
                    <p class="section-subtitle">Analizamos cada consulta según marca, modelo, medidas y aplicación. Si no conocés el modelo, una foto del componente o de la placa ayuda a iniciar la revisión.</p>
                </div>

                <div class="compat-line-grid">
                    <article class="compat-line-card" data-reveal style="--i: 1">
                        <div class="compat-card-image">
                            <img src="/platodesplazable_urvig.jpeg" alt="Componente compatible para consulta de equipo Urvig" loading="lazy" decoding="async">
                            <span>URVIG / COMPATIBLES</span>
                        </div>
                        <div class="compat-card-body">
                            <span class="compat-card-number">01</span>
                            <h3>Compatibles para equipos Urvig</h3>
                            <p>Repuestos compatibles para equipos Urvig. Asesoramiento técnico directo, fabricación nacional y envío a todo el país. Consultá por modelo, aplicación o foto del repuesto.</p>
                            <a
                                id="cta-whatsapp-urvig"
                                class="compat-text-link js-track-whatsapp"
                                data-event="whatsapp_clicked"
                                data-location="urvig_card"
                                href={`${whatsappBase}?text=${encodeURIComponent('Hola ANGO, necesito consultar un repuesto compatible para un equipo Urvig.')}`}
                                target="_blank"
                                rel="noopener noreferrer"
                            >Consultar Urvig <i class="ph-bold ph-arrow-up-right"></i></a>
                        </div>
                    </article>

                    <article class="compat-line-card" data-reveal style="--i: 2">
                        <div class="compat-card-image">
                            <img src="/conjunto-disco-embrague.png" alt="Conjunto industrial para consulta de compatibilidad con equipo Micron" loading="lazy" decoding="async">
                            <span>MICRON / COMPATIBLES</span>
                        </div>
                        <div class="compat-card-body">
                            <span class="compat-card-number">02</span>
                            <h3>Compatibles para equipos Micron</h3>
                            <p>Alternativas compatibles para equipos Micron. Revisamos modelo, medidas y aplicación para confirmar disponibilidad o fabricación.</p>
                            <a
                                id="cta-whatsapp-micron"
                                class="compat-text-link js-track-whatsapp"
                                data-event="whatsapp_clicked"
                                data-location="micron_card"
                                href={`${whatsappBase}?text=${encodeURIComponent('Hola ANGO, necesito consultar un repuesto compatible para un equipo Micron.')}`}
                                target="_blank"
                                rel="noopener noreferrer"
                            >Consultar Micron <i class="ph-bold ph-arrow-up-right"></i></a>
                        </div>
                    </article>
                </div>
            </div>
        </section>

        <section class="compat-catalog section" id="catalogo-repuestos">
            <div class="container">
                <div class="compat-catalog-heading" data-reveal>
                    <span class="section-kicker">Catálogo técnico</span>
                    <h2 class="section-title">Repuestos compatibles disponibles</h2>
                    <p class="section-subtitle">Consultá por código Urvig, equivalencia Micron o descripción del componente. Confirmamos compatibilidad y disponibilidad según equipo, modelo y aplicación.</p>
                </div>

                <div class="compat-catalog-shell" data-reveal style="--i: 1">
                    <div class="compat-catalog-meta" aria-hidden="true">
                        <span>ANGO / COMPATIBILIDAD INDUSTRIAL</span>
                        <span>{compatibleParts.length.toString().padStart(2, '0')} REFERENCIAS</span>
                    </div>

                    <table class="compat-catalog-table">
                        <caption class="sr-only">Listado de repuestos compatibles con códigos Urvig y equivalencias Micron</caption>
                        <thead>
                            <tr>
                                <th scope="col">Código Urvig</th>
                                <th scope="col">Equiv. Micron</th>
                                <th scope="col">Repuesto</th>
                                <th scope="col"><span class="sr-only">Acción</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            {compatibleParts.map((part) => (
                                <tr>
                                    <td data-label="Código Urvig"><code class="compat-code compat-code-primary">{part.urvigCode}</code></td>
                                    <td data-label="Equiv. Micron"><code class="compat-code">{part.micronCode}</code></td>
                                    <td data-label="Repuesto" class="compat-part-name">{part.description}</td>
                                    <td class="compat-part-action">
                                        <a
                                            class="compat-part-link"
                                            href={getPartWhatsAppUrl(part)}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            data-event="part_consulted"
                                            data-location="parts_catalog"
                                            data-part={part.description}
                                            data-urvig-code={part.urvigCode}
                                            data-micron-code={part.micronCode}
                                            aria-label={`Consultar ${part.description}, código Urvig ${part.urvigCode}`}
                                        >
                                            Consultar este repuesto
                                            <i class="ph-bold ph-arrow-up-right" aria-hidden="true"></i>
                                        </a>
                                    </td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <section class="compat-quote" id="cotizar">
            <div class="compat-quote-grid" aria-hidden="true"></div>
            <div class="container compat-quote-inner">
                <div class="compat-quote-copy" data-reveal>
                    <span class="section-kicker light">Cotización técnica</span>
                    <h2>Qué necesitamos para cotizar</h2>
                    <p>Completá los datos disponibles. Si no conocés el modelo, abrí WhatsApp después de enviar el formulario y adjuntá una foto.</p>

                    <ol class="compat-data-list">
                        <li><span>01</span> Marca del equipo</li>
                        <li><span>02</span> Modelo o placa</li>
                        <li><span>03</span> Foto del repuesto o embrague</li>
                        <li><span>04</span> Cantidad necesaria</li>
                        <li><span>05</span> Localidad y provincia</li>
                    </ol>
                </div>

                <form class="compat-form" id="compatibility-form" data-reveal style="--i: 1">
                    <div class="compat-field">
                        <label for="brand">Marca del equipo</label>
                        <select id="brand" name="brand" required>
                            <option value="">Seleccionar</option>
                            <option value="Urvig">Urvig</option>
                            <option value="Micron">Micron</option>
                            <option value="Otro">Otro</option>
                        </select>
                    </div>
                    <div class="compat-field">
                        <label for="part-code">Código Urvig o Micron <span>(opcional)</span></label>
                        <input id="part-code" name="partCode" type="text" placeholder="Ej: código Urvig o Micron">
                    </div>
                    <div class="compat-field">
                        <label for="model">Modelo o placa</label>
                        <input id="model" name="model" type="text" placeholder="Ej: modelo, serie o no lo conozco" required>
                    </div>
                    <div class="compat-field">
                        <label for="quantity">Cantidad</label>
                        <input id="quantity" name="quantity" type="number" min="1" value="1" required>
                    </div>
                    <div class="compat-field">
                        <label for="location">Localidad / provincia</label>
                        <input id="location" name="location" type="text" placeholder="Ej: Río Cuarto, Córdoba" required>
                    </div>
                    <div class="compat-field compat-field-wide">
                        <label for="contact">Teléfono o WhatsApp</label>
                        <input id="contact" name="contact" type="tel" placeholder="Código de área + número" required>
                    </div>
                    <div class="compat-field compat-field-wide">
                        <label for="details">Detalle adicional</label>
                        <textarea id="details" name="details" rows="3" placeholder="Aplicación, medidas o descripción del repuesto"></textarea>
                    </div>
                    <button id="lead-form-submit" data-event="lead_form_submitted" class="btn btn-gold compat-submit" type="submit">
                        <i class="ph-bold ph-whatsapp-logo"></i>
                        Enviar consulta por WhatsApp
                    </button>
                    <p class="compat-form-note">Al continuar se abrirá WhatsApp con los datos cargados. Podrás adjuntar la foto antes de enviar.</p>
                </form>
            </div>
        </section>

        <section class="compat-contact section">
            <div class="container compat-contact-grid">
                <div data-reveal>
                    <span class="section-kicker">Respuesta directa</span>
                    <h2 class="section-title">Hablemos de tu equipo</h2>
                    <p class="section-subtitle">Nuestro equipo revisa la información técnica para confirmar compatibilidad, disponibilidad o posibilidad de fabricación.</p>
                </div>
                <div class="compat-contact-actions" data-reveal style="--i: 1">
                    <a
                        id="cta-whatsapp-final"
                        class="btn btn-primary js-track-whatsapp"
                        data-event="whatsapp_clicked"
                        data-location="final"
                        href={`${whatsappBase}?text=${encodeURIComponent('Hola ANGO, quiero solicitar cotización y disponibilidad de un repuesto compatible para una toma de fuerza industrial.')}`}
                        target="_blank"
                        rel="noopener noreferrer"
                    ><i class="ph-bold ph-whatsapp-logo"></i> Consultar repuesto y disponibilidad</a>
                    <a id="cta-phone" class="btn btn-outline js-track-phone" data-event="phone_clicked" href="tel:+5493571699006"><i class="ph-bold ph-phone"></i> Llamar a ANGO</a>
                    <a id="cta-email" class="compat-email js-track-email" data-event="email_clicked" href="mailto:contacto@angometalurgica.com.ar">contacto@angometalurgica.com.ar</a>
                </div>
            </div>
        </section>

        <section class="compat-disclaimer">
            <div class="container">
                <p><strong>Aclaración de compatibilidad:</strong> Los nombres y códigos Urvig y Micron se utilizan únicamente para identificar compatibilidad. ANGO fabrica y comercializa soluciones compatibles. La equivalencia debe verificarse según equipo, modelo y aplicación.</p>
            </div>
        </section>
    </main>

    <a
        id="cta-whatsapp-mobile"
        class="compat-mobile-cta js-track-whatsapp"
        data-event="whatsapp_clicked"
        data-location="mobile_sticky"
        href={`${whatsappBase}?text=${encodeURIComponent('Hola ANGO, necesito solicitar cotización de un repuesto compatible para una toma de fuerza Urvig/Micron.')}`}
        target="_blank"
        rel="noopener noreferrer"
        aria-hidden="true"
        tabindex="-1"
    ><i class="ph-fill ph-whatsapp-logo"></i> Solicitar cotización por WhatsApp</a>

    <Footer />
</Layout>

<script>
    const conversionElements = document.querySelectorAll<HTMLElement>('[data-event]');
    const searchParams = new URLSearchParams(window.location.search);
    const utmSource = searchParams.get('utm_source');
    const utmCampaign = searchParams.get('utm_campaign');

    conversionElements.forEach((element) => {
        element.addEventListener('click', () => {
            window.dispatchEvent(new CustomEvent('ango:conversion-intent', {
                detail: {
                    event: element.dataset.event,
                    location: element.dataset.location ?? 'not_set',
                    part: element.dataset.part ?? null,
                    urvig_code: element.dataset.urvigCode ?? null,
                    micron_code: element.dataset.micronCode ?? null,
                    utm_source: utmSource,
                    utm_campaign: utmCampaign
                }
            }));
        });
    });

    const form = document.querySelector<HTMLFormElement>('#compatibility-form');
    const mobileCta = document.querySelector<HTMLElement>('#cta-whatsapp-mobile');
    const hero = document.querySelector<HTMLElement>('.compat-hero');
    const suppressionSections = document.querySelectorAll<HTMLElement>('#catalogo-repuestos, #cotizar');

    if (mobileCta && hero) {
        let heroPassed = false;
        const visibleSuppressionSections = new Set<Element>();

        const updateMobileCta = () => {
            const shouldShow = heroPassed && visibleSuppressionSections.size === 0;
            mobileCta.classList.toggle('is-visible', shouldShow);
            mobileCta.setAttribute('aria-hidden', shouldShow ? 'false' : 'true');

            if (shouldShow) {
                mobileCta.removeAttribute('tabindex');
            } else {
                mobileCta.setAttribute('tabindex', '-1');
            }
        };

        const heroObserver = new IntersectionObserver(([entry]) => {
            heroPassed = !entry.isIntersecting && entry.boundingClientRect.bottom <= 0;
            updateMobileCta();
        }, { threshold: 0 });

        const suppressionObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    visibleSuppressionSections.add(entry.target);
                } else {
                    visibleSuppressionSections.delete(entry.target);
                }
            });

            updateMobileCta();
        }, { threshold: 0.01 });

        heroObserver.observe(hero);
        suppressionSections.forEach((section) => suppressionObserver.observe(section));
        updateMobileCta();
    }

    form?.addEventListener('submit', (event) => {
        event.preventDefault();

        const data = new FormData(form);
        const messageLines = [
            'Hola ANGO, necesito cotizar un repuesto compatible.',
            '',
            `Marca: ${data.get('brand') ?? ''}`,
            `Código de repuesto: ${data.get('partCode') || 'No informado'}`,
            `Modelo o placa: ${data.get('model') ?? ''}`,
            `Cantidad: ${data.get('quantity') ?? ''}`,
            `Localidad / provincia: ${data.get('location') ?? ''}`,
            `Contacto: ${data.get('contact') ?? ''}`,
            `Detalle: ${data.get('details') || 'Sin detalle adicional'}`,
            '',
            'Voy a adjuntar una foto para revisar compatibilidad.'
        ];

        if (utmSource || utmCampaign) {
            messageLines.push('', `Origen: ${utmSource ?? 'directo'} / ${utmCampaign ?? 'sin campaña'}`);
        }

        window.dispatchEvent(new CustomEvent('ango:conversion-intent', {
            detail: {
                event: 'lead_form_submitted',
                location: 'compatibility_form',
                utm_source: utmSource,
                utm_campaign: utmCampaign
            }
        }));

        window.open(`https://wa.me/5493571699006?text=${encodeURIComponent(messageLines.join('\n'))}`, '_blank', 'noopener,noreferrer');
    });
</script>

<style>
    :global(.wa-fab) { display: none !important; }

    .compat-page {
        background: var(--color-surface);
        overflow: hidden;
        padding-top: 76px;
    }

    .compat-hero {
        background:
            radial-gradient(circle at 75% 38%, rgba(0, 87, 184, 0.12), transparent 26%),
            linear-gradient(135deg, #fff 0%, var(--color-surface-soft) 100%);
        min-height: 760px;
        overflow: hidden;
        position: relative;
    }

    .compat-grid,
    .compat-quote-grid {
        background-image:
            linear-gradient(rgba(6, 40, 70, 0.055) 1px, transparent 1px),
            linear-gradient(90deg, rgba(6, 40, 70, 0.055) 1px, transparent 1px);
        background-size: 28px 28px;
        inset: 0;
        pointer-events: none;
        position: absolute;
    }

    .compat-hero-inner {
        align-items: center;
        display: grid;
        gap: 48px;
        min-height: 760px;
        padding-bottom: 70px;
        padding-top: 70px;
        position: relative;
        z-index: 1;
    }

    .compat-hero-copy h1 {
        color: var(--color-dark);
        font-family: var(--font-heading);
        font-size: clamp(43px, 6vw, 82px);
        font-weight: 900;
        letter-spacing: -0.045em;
        line-height: 0.95;
        margin-bottom: 26px;
        max-width: 820px;
        text-transform: uppercase;
    }

    .compat-hero-copy h1::after {
        color: var(--color-yellow);
        content: ".";
    }

    .compat-lead {
        color: #334155;
        font-size: clamp(17px, 2vw, 20px);
        line-height: 1.65;
        max-width: 680px;
    }

    .compat-hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        margin-top: 34px;
    }

    .compat-proof-list {
        display: flex;
        flex-wrap: wrap;
        gap: 15px 24px;
        list-style: none;
        margin-top: 30px;
    }

    .compat-proof-list li {
        align-items: center;
        color: var(--color-dark);
        display: flex;
        font-family: var(--font-mono);
        font-size: 12px;
        font-weight: 700;
        gap: 7px;
        text-transform: uppercase;
    }

    .compat-proof-list i { color: var(--color-primary); }

    .compat-hero-visual {
        border: 1px solid rgba(6, 40, 70, 0.24);
        min-height: 500px;
        position: relative;
    }

    .compat-hero-visual::before {
        border-left: 16px solid var(--color-yellow);
        border-top: 16px solid var(--color-yellow);
        content: '';
        height: 58px;
        left: -1px;
        position: absolute;
        top: -1px;
        width: 58px;
        z-index: 3;
    }

    .compat-figure-label {
        color: var(--color-ink-secondary);
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 700;
        left: 28px;
        letter-spacing: .08em;
        position: absolute;
        top: 26px;
        z-index: 3;
    }

    .compat-hero-image-wrap {
        inset: 58px 44px 72px;
        overflow: hidden;
        position: absolute;
    }

    .compat-hero-image {
        height: 100%;
        object-fit: cover;
        width: 100%;
    }

    .compat-callout {
        align-items: center;
        background: rgba(255,255,255,.95);
        border-left: 3px solid var(--color-primary);
        box-shadow: 0 12px 25px rgba(3,26,47,.14);
        display: flex;
        gap: 10px;
        padding: 11px 14px;
        position: absolute;
        z-index: 4;
    }

    .compat-callout span {
        color: var(--color-primary);
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 700;
    }

    .compat-callout strong {
        color: var(--color-dark);
        font-size: 12px;
        text-transform: uppercase;
    }

    .compat-callout-model { right: 2%; top: 25%; }
    .compat-callout-photo { bottom: 20%; left: 2%; }

    .compat-hero-stamp {
        bottom: 20px;
        display: grid;
        gap: 2px;
        position: absolute;
        right: 24px;
        text-align: right;
    }

    .compat-hero-stamp small {
        color: var(--color-primary);
        font-family: var(--font-mono);
        font-size: 8px;
        letter-spacing: .08em;
    }

