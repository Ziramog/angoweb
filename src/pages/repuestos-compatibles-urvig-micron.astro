---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const title = 'Repuestos compatibles para Urvig y Micron | ANGO Metalúrgica';
const description = 'Repuestos compatibles nacionales para equipos Urvig y Micron. Enviá modelo, medidas o foto y recibí cotización para tomas de fuerza industriales.';
const canonical = 'https://www.angometalurgica.com.ar/repuestos-compatibles-urvig-micron';
const whatsappBase = 'https://wa.me/5493571699006';

const compatibleParts = [
    { urvigCode: 'TAE47A', micronCode: '104134428', description: 'Corona dentada', image: '/corona.png' },
    { urvigCode: 'TAE203B', micronCode: '104334016', description: 'Eje principal toma de fuerza', image: '/ejes.png' },
    { urvigCode: 'TAA13A', micronCode: '24300209', description: 'Tuerca de eje principal', image: null },
    { urvigCode: 'TAA10A', micronCode: '103934011', description: 'Conjunto collar de bronce', image: '/collardebronce.png' },
    { urvigCode: 'TAE45A', micronCode: '104134007', description: 'Plato con cubo', image: '/platoconcono_urvig.jpeg' },
    { urvigCode: 'TAAD3A', micronCode: '104134005', description: 'Plato liso desplazable', image: '/platodesplazable_urvig.jpeg' },
    { urvigCode: 'TAE46A', micronCode: '104134026', description: 'Plato liso separador', image: null },
    { urvigCode: 'TBA06A', micronCode: '104134010', description: 'Horquilla de accionamiento', image: null },
    { urvigCode: 'TAA09A', micronCode: '104134013', description: 'Buje accionamiento leva — pata araña', image: '/portacollar_urvig.jpeg' },
    { urvigCode: 'TAA12A', micronCode: '104334118', description: 'Leva aprieta disco', image: null },
    { urvigCode: 'TAA11A', micronCode: '102324120', description: 'Brazo de articulación', image: null },
    { urvigCode: 'TAE44A', micronCode: '98342044506', description: 'Resorte de plato', image: '/resorte_plato.png' },
    { urvigCode: 'TAA14B', micronCode: '104334119', description: 'Perno de leva sin cabeza', image: null },
    { urvigCode: 'TAA15B', micronCode: '104334021', description: 'Perno brazo de articulación sin cabeza', image: null },
    { urvigCode: 'TAA18A', micronCode: 'N/A', description: 'Juego de ferodos', image: '/ferodos2.png' }
];

const getPartWhatsAppUrl = (part: typeof compatibleParts[number]) => {
    const message = [
        'Hola ANGO, quiero consultar disponibilidad de este repuesto compatible.',
        '',
        `Repuesto: ${part.description}`,
        `Código Urvig: ${part.urvigCode}`,
        `Equivalente Micron: ${part.micronCode}`,
        'Cantidad:'
    ].join('\n');

    return `${whatsappBase}?text=${encodeURIComponent(message)}`;
};
---

<Layout title={title} description={description} canonical={canonical}>
    <Navbar forceScrolled={true} />

    <main class="compat-page">
        <section class="compat-hero">
            <div class="compat-grid" aria-hidden="true"></div>
            <div class="container compat-hero-inner">
                <div class="compat-hero-copy" data-reveal>
                    <span class="section-kicker">Soluciones compatibles</span>
                    <h1>Repuestos compatibles para Urvig y Micron</h1>
                    <p class="compat-lead">Fabricación nacional de piezas compatibles para reparación y mantenimiento de tomas de fuerza industriales. Enviá modelo, medidas o foto del repuesto y te cotizamos.</p>
                </div>

                <div class="compat-hero-visual" data-reveal style="--i: 1">
                    <span class="compat-figure-label">FIG. <span id="hero-rotating-number">01</span> / REPUESTO COMPATIBLE URVIG / MICRON</span>
                    <div class="compat-hero-image-wrap">
                        <img id="hero-rotating-image" src="/platoconcono_urvig.jpeg" alt="Repuesto compatible nacional para toma de fuerza industrial" class="compat-hero-image" width="900" height="900" decoding="async">
                    </div>
                </div>

                <div class="compat-hero-actions" data-reveal style="--i: 2">
                    <a
                        id="cta-whatsapp-hero"
                        class="btn btn-primary js-track-whatsapp"
                        data-event="whatsapp_clicked"
                        data-location="hero"
                        href={`${whatsappBase}?text=${encodeURIComponent('Hola ANGO, necesito solicitar cotización de un repuesto compatible para una toma de fuerza Urvig/Micron. Puedo enviar modelo, medidas o foto.')}`}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <i class="ph-bold ph-whatsapp-logo"></i>
                        Solicitar cotización
                    </a>
                    <a class="btn btn-outline" href="#cotizar">
                        <i class="ph-bold ph-camera"></i>
                        Enviar modelo o foto
                    </a>
                </div>

            </div>
        </section>

        <section class="compat-band" aria-label="Beneficios">
            <div class="container compat-band-grid">
                <div><i class="ph-fill ph-truck"></i><strong>Envíos a todo el país</strong></div>
                <div><i class="ph-fill ph-shield-check"></i><strong>Calidad garantizada</strong></div>
                <div><i class="ph-fill ph-clock"></i><strong>Entrega inmediata</strong></div>
            </div>
        </section>

        <section class="compat-catalog section" id="catalogo-repuestos">
            <div class="container">
                <div class="compat-catalog-heading" data-reveal>
                    <span class="section-kicker">Catálogo técnico</span>
                    <h2 class="section-title">Repuestos compatibles disponibles</h2>
                    <p class="section-subtitle">Consultá por código Urvig, equivalencia Micron o descripción del componente. Confirmamos compatibilidad y disponibilidad según equipo, modelo y aplicación.</p>
                    <div class="compat-availability-badge">
                        <i class="ph-bold ph-check-circle" aria-hidden="true"></i>
                        <div>
                            <strong>Disponible para modelos de tomas de fuerza:</strong> 
                            <span class="availability-desc">Mono Disco y Doble Disco<br>versiones de 11" 1/2 y 14".</span>
                        </div>
                    </div>
                </div>

                <div class="compat-catalog-shell" data-reveal style="--i: 1">
                    <div class="compat-catalog-meta" aria-hidden="true">
                        <span>ANGO / COMPATIBILIDAD INDUSTRIAL</span>
                        <span>{compatibleParts.length.toString().padStart(2, '0')} REFERENCIAS</span>
                    </div>

                    <table class="compat-catalog-table">
                        <caption class="sr-only">Listado de repuestos compatibles con códigos Urvig y equivalencias Micron</caption>
                        <thead>
                            <tr>
                                <th scope="col" class="compat-col-photo"><span class="sr-only">Foto</span></th>
                                <th scope="col">Repuesto</th>
                                <th scope="col">Código Urvig</th>
                                <th scope="col">Equiv. Micron</th>
                                <th scope="col"><span class="sr-only">Acción</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            {compatibleParts.map((part) => (
                                <tr>
                                    <td class="compat-part-photo">
                                        {part.image ? (
                                            <div class="part-photo-wrap">
                                                <img src={part.image} alt={part.description} loading="lazy" decoding="async" />
                                            </div>
                                        ) : (
                                            <div class="photo-placeholder"><i class="ph-bold ph-camera" aria-hidden="true"></i></div>
                                        )}
                                    </td>
                                    <td data-label="Repuesto" class="compat-part-name">{part.description}</td>
                                    <td data-label="Código Urvig" class="compat-part-urvig"><code class="compat-code compat-code-primary">{part.urvigCode}</code></td>
                                    <td data-label="Equiv. Micron" class="compat-part-micron"><code class="compat-code">{part.micronCode}</code></td>
                                    <td class="compat-part-action">
                                        <a
                                            class="compat-part-link"
                                            href={getPartWhatsAppUrl(part)}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            data-event="part_consulted"
                                            data-location="parts_catalog"
                                            data-part={part.description}
                                            data-urvig-code={part.urvigCode}
                                            data-micron-code={part.micronCode}
                                            aria-label={`Consultar ${part.description}, código Urvig ${part.urvigCode}`}
                                        >
                                            Consultar
                                            <i class="ph-bold ph-arrow-up-right" aria-hidden="true"></i>
                                        </a>
                                    </td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <section class="compat-quote" id="cotizar">
            <div class="compat-quote-grid" aria-hidden="true"></div>
            <div class="container compat-quote-inner">
                <div class="compat-quote-copy" data-reveal>
                    <span class="section-kicker light">Cotización técnica</span>
                    <h2>Qué necesitamos para cotizar</h2>
                    <p>Completá los datos disponibles. Una vez que hablemos por WhatsApp vas a poder adjuntarnos fotos del repuesto o equipo.</p>

                    <ol class="compat-data-list">
                        <li><span>01</span> ¿Qué necesitás?</li>
                        <li><span>02</span> Marca del equipo</li>
                        <li><span>03</span> Modelo de embrague</li>
                        <li><span>04</span> Localidad y provincia</li>
                    </ol>
                </div>

                <form class="compat-form" id="compatibility-form" data-reveal style="--i: 1">
                    <div class="compat-field">
                        <label for="brand">Marca del equipo</label>
                        <select id="brand" name="brand" required>
                            <option value="">Seleccionar</option>
                            <option value="Urvig">Urvig</option>
                            <option value="Micron">Micron</option>
                            <option value="Otro">Otro</option>
                        </select>
                    </div>
                    <div class="compat-field">
                        <label for="model">Modelo de embrague</label>
                        <select id="model" name="model" required>
                            <option value="">Seleccionar modelo...</option>
                            <option value="11&quot; 1/2 Monodisco">11" 1/2 Monodisco</option>
                            <option value="11&quot; 1/2 Doble Disco">11" 1/2 Doble Disco</option>
                            <option value="14&quot; Doble Disco">14" Doble Disco</option>
                            <option value="14&quot; Triple Disco">14" Triple Disco</option>
                            <option value="No estoy seguro">No estoy seguro</option>
                        </select>
                    </div>
                    <div class="compat-field">
                        <label for="interest">¿Qué necesitás?</label>
                        <select id="interest" name="interest" required>
                            <option value="">Seleccionar...</option>
                            <option value="Servicio de reacondicionamiento">Servicio de reacondicionamiento</option>
                            <option value="Comprar repuestos">Comprar repuestos</option>
                        </select>
                    </div>
                    <div class="compat-field">
                        <label for="location">Localidad / provincia</label>
                        <input id="location" name="location" type="text" placeholder="Ej: Río Cuarto, Córdoba" required>
                    </div>

                    <div class="compat-field compat-field-wide">
                        <label for="details">Detalle adicional</label>
                        <textarea id="details" name="details" rows="3" placeholder="Aplicación, medidas o descripción del repuesto"></textarea>
                    </div>
                    <button id="lead-form-submit" data-event="lead_form_submitted" class="btn btn-gold compat-submit" type="submit">
                        <i class="ph-bold ph-whatsapp-logo"></i>
                        Enviar consulta por WhatsApp
                    </button>
                    <p class="compat-form-note">Al continuar se abrirá WhatsApp con los datos cargados.</p>
                </form>
            </div>
        </section>

        <section class="compat-contact section">
            <div class="container compat-contact-grid">
                <div data-reveal>
                    <span class="section-kicker">Respuesta directa</span>
                    <h2 class="section-title">Hablemos de tu equipo</h2>
                    <p class="section-subtitle">Nuestro equipo revisa la información técnica para confirmar compatibilidad, disponibilidad o posibilidad de fabricación.</p>
                </div>
                <div class="compat-contact-actions" data-reveal style="--i: 1">
                    <a
                        id="cta-whatsapp-final"
                        class="btn btn-primary js-track-whatsapp"
                        data-event="whatsapp_clicked"
                        data-location="final"
                        href={`${whatsappBase}?text=${encodeURIComponent('Hola ANGO, quiero solicitar cotización y disponibilidad de un repuesto compatible para una toma de fuerza industrial.')}`}
                        target="_blank"
                        rel="noopener noreferrer"
                    ><i class="ph-bold ph-whatsapp-logo"></i> Consultar repuesto y disponibilidad</a>
                    <a id="cta-phone" class="btn btn-outline js-track-phone" data-event="phone_clicked" href="tel:+5493571699006"><i class="ph-bold ph-phone"></i> Llamar a ANGO</a>
                    <a id="cta-email" class="compat-email js-track-email" data-event="email_clicked" href="mailto:contacto@angometalurgica.com.ar">contacto@angometalurgica.com.ar</a>
                </div>
            </div>
        </section>

        <section class="compat-disclaimer">
            <div class="container">
                <p><strong>Aclaración de compatibilidad:</strong> Los nombres y códigos Urvig y Micron se utilizan únicamente para identificar compatibilidad. ANGO fabrica y comercializa soluciones compatibles. La equivalencia debe verificarse según equipo, modelo y aplicación.</p>
            </div>
        </section>
    </main>

    <a
        id="cta-whatsapp-mobile"
        class="compat-mobile-cta js-track-whatsapp"
        data-event="whatsapp_clicked"
        data-location="mobile_sticky"
        href={`${whatsappBase}?text=${encodeURIComponent('Hola ANGO, necesito solicitar cotización de un repuesto compatible para una toma de fuerza Urvig/Micron.')}`}
        target="_blank"
        rel="noopener noreferrer"
        aria-hidden="true"
        tabindex="-1"
    ><i class="ph-fill ph-whatsapp-logo"></i> Consultar por WhatsApp</a>

    <dialog id="photo-modal" class="compat-photo-modal">
        <button id="photo-modal-close" class="modal-close" aria-label="Cerrar"><i class="ph-bold ph-x"></i></button>
        <img id="photo-modal-img" src="" alt="Ampliación de repuesto">
    </dialog>

    <Footer />
</Layout>

<script>
    const conversionElements = document.querySelectorAll<HTMLElement>('[data-event]');
    const searchParams = new URLSearchParams(window.location.search);
    const utmSource = searchParams.get('utm_source');
    const utmCampaign = searchParams.get('utm_campaign');

    conversionElements.forEach((element) => {
        element.addEventListener('click', () => {
            window.dispatchEvent(new CustomEvent('ango:conversion-intent', {
                detail: {
                    event: element.dataset.event,
                    location: element.dataset.location ?? 'not_set',
                    part: element.dataset.part ?? null,
                    urvig_code: element.dataset.urvigCode ?? null,
                    micron_code: element.dataset.micronCode ?? null,
                    utm_source: utmSource,
                    utm_campaign: utmCampaign
                }
            }));
        });
    });

    const form = document.querySelector<HTMLFormElement>('#compatibility-form');
    const mobileCta = document.querySelector<HTMLElement>('#cta-whatsapp-mobile');
    const hero = document.querySelector<HTMLElement>('.compat-hero');
    const suppressionSections = document.querySelectorAll<HTMLElement>('#catalogo-repuestos, #cotizar');

    if (mobileCta && hero) {
        let heroPassed = false;
        const visibleSuppressionSections = new Set<Element>();

        const updateMobileCta = () => {
            const shouldShow = heroPassed && visibleSuppressionSections.size === 0;
            mobileCta.classList.toggle('is-visible', shouldShow);
            mobileCta.setAttribute('aria-hidden', shouldShow ? 'false' : 'true');

            if (shouldShow) {
                mobileCta.removeAttribute('tabindex');
            } else {
                mobileCta.setAttribute('tabindex', '-1');
            }
        };

        const heroObserver = new IntersectionObserver(([entry]) => {
            heroPassed = !entry.isIntersecting && entry.boundingClientRect.bottom <= 0;
            updateMobileCta();
        }, { threshold: 0 });

        const suppressionObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    visibleSuppressionSections.add(entry.target);
                } else {
                    visibleSuppressionSections.delete(entry.target);
                }
            });

            updateMobileCta();
        }, { threshold: 0.01 });

        heroObserver.observe(hero);
        suppressionSections.forEach((section) => suppressionObserver.observe(section));
        updateMobileCta();
    }

    form?.addEventListener('submit', (event) => {
        event.preventDefault();

        const data = new FormData(form);
        const messageLines = [
            'Hola ANGO, necesito cotizar un embrague o repuesto compatible.',
            '',
            `Interés: ${data.get('interest') ?? ''}`,
            `Marca: ${data.get('brand') ?? ''}`,
            `Modelo de embrague: ${data.get('model') ?? ''}`,
            `Localidad / provincia: ${data.get('location') ?? ''}`,
            `Detalle: ${data.get('details') || 'Sin detalle adicional'}`
        ];

        if (utmSource || utmCampaign) {
            messageLines.push('', `Origen: ${utmSource ?? 'directo'} / ${utmCampaign ?? 'sin campaña'}`);
        }

        window.dispatchEvent(new CustomEvent('ango:conversion-intent', {
            detail: {
                event: 'lead_form_submitted',
                location: 'compatibility_form',
                utm_source: utmSource,
                utm_campaign: utmCampaign
            }
        }));

        window.open(`https://wa.me/5493571699006?text=${encodeURIComponent(messageLines.join('\n'))}`, '_blank', 'noopener,noreferrer');
    });

    const heroImages = [
        '/corona.png',
        '/ejes.png',
        '/collardebronce.png',
        '/platoconcono_urvig.jpeg',
        '/platodesplazable_urvig.jpeg',
        '/portacollar_urvig.jpeg',
        '/ferodos2.png',
        '/resorte_plato.png'
    ];
    const rotatingImage = document.getElementById('hero-rotating-image') as HTMLImageElement;
    if (rotatingImage) {
        let currentImageIndex = 0;
        setInterval(() => {
            currentImageIndex = (currentImageIndex + 1) % heroImages.length;
            rotatingImage.style.opacity = '0';
            setTimeout(() => {
                rotatingImage.src = heroImages[currentImageIndex];
                rotatingImage.style.opacity = '1';
                const rotatingNumber = document.getElementById('hero-rotating-number');
                if (rotatingNumber) {
                    rotatingNumber.textContent = String(currentImageIndex + 1).padStart(2, '0');
                }
            }, 300);
        }, 2000);
    }

    const modal = document.getElementById('photo-modal') as HTMLDialogElement;
    const modalImg = document.getElementById('photo-modal-img') as HTMLImageElement;
    const modalClose = document.getElementById('photo-modal-close');

    if (modal && modalImg && modalClose) {
        document.querySelectorAll('.part-photo-wrap').forEach(wrap => {
            const htmlWrap = wrap as HTMLElement;
            htmlWrap.style.cursor = 'pointer';
            htmlWrap.addEventListener('click', () => {
                const img = htmlWrap.querySelector('img');
                if (img) {
                    modalImg.src = img.src;
                    modal.showModal();
                }
            });
        });

        modalClose.addEventListener('click', () => modal.close());
        modal.addEventListener('click', (e) => {
            if (e.target === modal) modal.close();
        });
    }
</script>

<style>
    :global(.wa-fab) { display: none !important; }

    .compat-page {
        background: var(--color-surface);
        overflow: hidden;
        padding-top: 76px;
    }

    .compat-hero {
        background:
            radial-gradient(circle at 75% 38%, rgba(0, 87, 184, 0.12), transparent 26%),
            linear-gradient(135deg, #fff 0%, var(--color-surface-soft) 100%);
        min-height: 760px;
        overflow: hidden;
        position: relative;
    }

    .compat-grid,
    .compat-quote-grid {
        background-image:
            linear-gradient(rgba(6, 40, 70, 0.055) 1px, transparent 1px),
            linear-gradient(90deg, rgba(6, 40, 70, 0.055) 1px, transparent 1px);
        background-size: 28px 28px;
        inset: 0;
        pointer-events: none;
        position: absolute;
    }

    .compat-hero-inner {
        align-items: center;
        display: grid;
        gap: 0;
        min-height: 760px;
        padding-bottom: 70px;
        padding-top: 70px;
        position: relative;
        z-index: 1;
    }

    .compat-hero-copy h1 {
        color: var(--color-dark);
        font-family: var(--font-heading);
        font-size: clamp(34px, 5vw, 64px);
        font-weight: 900;
        letter-spacing: -0.03em;
        line-height: 1.05;
        margin-bottom: 20px;
        max-width: 820px;
        text-transform: uppercase;
    }

    .compat-hero-copy h1::after {
        color: var(--color-yellow);
        content: ".";
    }

    .compat-lead {
        color: #334155;
        font-size: clamp(17px, 2vw, 20px);
        line-height: 1.65;
        max-width: 680px;
    }

    .compat-hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        margin-top: 34px;
        margin-bottom: 24px;
    }

    #cta-whatsapp-hero i { font-size: 24px; }

    .compat-hero-visual {
        background: #fff;
        border: 1px solid rgba(6, 40, 70, 0.24);
        min-height: 500px;
        position: relative;
    }

    .compat-hero-visual::before {
        border-left: 16px solid var(--color-yellow);
        border-top: 16px solid var(--color-yellow);
        content: '';
        height: 58px;
        left: -1px;
        position: absolute;
        top: -1px;
        width: 58px;
        z-index: 3;
    }

    .compat-figure-label {
        color: var(--color-ink-secondary);
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 700;
        left: 28px;
        letter-spacing: .08em;
        position: absolute;
        top: 26px;
        z-index: 3;
    }

    .compat-hero-image-wrap {
        inset: 58px 44px 72px;
        overflow: hidden;
        position: absolute;
    }

    .compat-hero-image {
        height: 100%;
        object-fit: contain;
        width: 100%;
        transition: opacity 0.3s ease-in-out;
    }

    .compat-band { background: var(--color-dark); }

    .compat-band-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        padding-bottom: 36px;
        padding-top: 36px;
    }

    .compat-band-grid div {
        align-items: center;
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.04) 0%, rgba(255, 255, 255, 0.01) 100%);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-top: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 16px;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1), 0 4px 20px -4px rgba(0, 0, 0, 0.5);
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 20px 8px;
        position: relative;
        text-align: center;
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        overflow: hidden;
    }
    
    .compat-band-grid div::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at top center, rgba(0, 87, 184, 0.15) 0%, transparent 70%);
        opacity: 0;
        transition: opacity 0.4s ease;
    }

    .compat-band-grid div:hover {
        transform: translateY(-4px) scale(1.02);
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0.02) 100%);
        border-color: rgba(255, 255, 255, 0.25);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2), 0 12px 30px -8px rgba(0, 0, 0, 0.6);
    }
    
    .compat-band-grid div:hover::before {
        opacity: 1;
    }

    .compat-band-grid i {
        color: var(--color-yellow);
        font-size: 28px;
        filter: drop-shadow(0 2px 8px rgba(255, 184, 28, 0.4));
        margin-bottom: 2px;
        position: relative;
        z-index: 1;
        transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
