---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const title = 'Repuestos compatibles para Urvig y Micron | ANGO Metalúrgica';
const description = 'Repuestos compatibles para equipos Urvig y Micron. Fabricación nacional, asesoramiento técnico y verificación de compatibilidad por modelo o foto.';
const canonical = 'https://www.angometalurgica.com.ar/repuestos-compatibles-urvig-micron';
const whatsappBase = 'https://wa.me/5493571699006';
---

<Layout title={title} description={description} canonical={canonical}>
    <Navbar forceScrolled={true} />

    <main class="compat-page">
        <section class="compat-hero">
            <div class="compat-grid" aria-hidden="true"></div>
            <div class="container compat-hero-inner">
                <div class="compat-hero-copy" data-reveal>
                    <span class="section-kicker">Soluciones compatibles</span>
                    <h1>Repuestos compatibles para Urvig y Micron</h1>
                    <p class="compat-lead">Fabricación nacional y soluciones compatibles para mantenimiento de equipos industriales. Consultá disponibilidad según modelo.</p>

                    <div class="compat-hero-actions">
                        <a
                            id="cta-whatsapp-hero"
                            class="btn btn-primary js-track-whatsapp"
                            data-event="whatsapp_clicked"
                            data-location="hero"
                            href={`${whatsappBase}?text=${encodeURIComponent('Hola ANGO, necesito consultar compatibilidad de un repuesto para un equipo Urvig/Micron.')}`}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            <i class="ph-bold ph-whatsapp-logo"></i>
                            Consultar compatibilidad
                        </a>
                        <a class="btn btn-outline" href="#cotizar">
                            <i class="ph-bold ph-camera"></i>
                            Enviar datos o foto
                        </a>
                    </div>

                    <ul class="compat-proof-list" aria-label="Ventajas del servicio">
                        <li><i class="ph-bold ph-check"></i> Verificación por modelo</li>
                        <li><i class="ph-bold ph-check"></i> Fabricación nacional</li>
                        <li><i class="ph-bold ph-check"></i> Envíos a todo el país</li>
                    </ul>
                </div>

                <div class="compat-hero-visual" data-reveal style="--i: 1">
                    <span class="compat-figure-label">FIG. 01 / COMPATIBILIDAD</span>
                    <div class="compat-hero-image-wrap">
                        <img src="/platoconcono_urvig.jpeg" alt="Componente industrial para verificación de compatibilidad" class="compat-hero-image" width="900" height="900" decoding="async">
                    </div>
                    <div class="compat-callout compat-callout-model">
                        <span>01</span>
                        <strong>Modelo o placa</strong>
                    </div>
                    <div class="compat-callout compat-callout-photo">
                        <span>02</span>
                        <strong>Foto y medidas</strong>
                    </div>
                    <div class="compat-hero-stamp">
                        <small>ANGO METALÚRGICA</small>
                        <strong>CONSULTAR COMPATIBILIDAD</strong>
                    </div>
                </div>
            </div>
        </section>

        <section class="compat-band" aria-label="Proceso de consulta">
            <div class="container compat-band-grid">
                <div><span>01</span><strong>Identificamos el equipo</strong></div>
                <div><span>02</span><strong>Revisamos modelo y medidas</strong></div>
                <div><span>03</span><strong>Confirmamos disponibilidad</strong></div>
            </div>
        </section>

        <section class="compat-lines section" id="compatibles">
            <div class="container">
                <div class="compat-section-heading" data-reveal>
                    <div>
                        <span class="section-kicker">Líneas compatibles</span>
                        <h2 class="section-title">Urvig y Micron</h2>
                    </div>
                    <p class="section-subtitle">Analizamos cada consulta según marca, modelo, medidas y aplicación. Si no conocés el modelo, una foto del componente o de la placa ayuda a iniciar la revisión.</p>
                </div>

                <div class="compat-line-grid">
                    <article class="compat-line-card" data-reveal style="--i: 1">
                        <div class="compat-card-image">
                            <img src="/platodesplazable_urvig.jpeg" alt="Componente compatible para consulta de equipo Urvig" loading="lazy" decoding="async">
                            <span>URVIG / COMPATIBLES</span>
                        </div>
                        <div class="compat-card-body">
                            <span class="compat-card-number">01</span>
                            <h3>Compatibles para equipos Urvig</h3>
                            <p>Repuestos compatibles para equipos Urvig. Asesoramiento técnico directo, fabricación nacional y envío a todo el país. Consultá por modelo, aplicación o foto del repuesto.</p>
                            <a
                                id="cta-whatsapp-urvig"
                                class="compat-text-link js-track-whatsapp"
                                data-event="whatsapp_clicked"
                                data-location="urvig_card"
                                href={`${whatsappBase}?text=${encodeURIComponent('Hola ANGO, necesito consultar un repuesto compatible para un equipo Urvig.')}`}
                                target="_blank"
                                rel="noopener noreferrer"
                            >Consultar Urvig <i class="ph-bold ph-arrow-up-right"></i></a>
                        </div>
                    </article>

                    <article class="compat-line-card" data-reveal style="--i: 2">
                        <div class="compat-card-image">
                            <img src="/conjunto-disco-embrague.png" alt="Conjunto industrial para consulta de compatibilidad con equipo Micron" loading="lazy" decoding="async">
                            <span>MICRON / COMPATIBLES</span>
                        </div>
                        <div class="compat-card-body">
                            <span class="compat-card-number">02</span>
                            <h3>Compatibles para equipos Micron</h3>
                            <p>Alternativas compatibles para equipos Micron. Revisamos modelo, medidas y aplicación para confirmar disponibilidad o fabricación.</p>
                            <a
                                id="cta-whatsapp-micron"
                                class="compat-text-link js-track-whatsapp"
                                data-event="whatsapp_clicked"
                                data-location="micron_card"
                                href={`${whatsappBase}?text=${encodeURIComponent('Hola ANGO, necesito consultar un repuesto compatible para un equipo Micron.')}`}
                                target="_blank"
                                rel="noopener noreferrer"
                            >Consultar Micron <i class="ph-bold ph-arrow-up-right"></i></a>
                        </div>
                    </article>
                </div>
            </div>
        </section>

        <section class="compat-parts section">
            <div class="container">
                <div class="compat-parts-heading" data-reveal>
                    <span class="section-kicker">Revisión técnica</span>
                    <h2 class="section-title">Consultá por tu repuesto</h2>
                    <p class="section-subtitle">Podemos revisar componentes, conjuntos y piezas de desgaste. La compatibilidad se confirma antes de cotizar.</p>
                </div>

                <div class="compat-parts-grid">
                    <figure data-reveal style="--i: 1">
                        <img src="/platoconcono_urvig.jpeg" alt="Plato industrial para consulta de compatibilidad" loading="lazy" decoding="async">
                        <figcaption><span>01</span> Platos y conjuntos</figcaption>
                    </figure>
                    <figure data-reveal style="--i: 2">
                        <img src="/platodesplazable_urvig.jpeg" alt="Plato desplazable para consulta técnica" loading="lazy" decoding="async">
                        <figcaption><span>02</span> Componentes móviles</figcaption>
                    </figure>
                    <figure data-reveal style="--i: 3">
                        <img src="/portacollar_urvig.jpeg" alt="Portacollar para verificación por modelo" loading="lazy" decoding="async">
                        <figcaption><span>03</span> Portacollar y accionamiento</figcaption>
                    </figure>
                </div>
            </div>
        </section>

        <section class="compat-quote" id="cotizar">
            <div class="compat-quote-grid" aria-hidden="true"></div>
            <div class="container compat-quote-inner">
                <div class="compat-quote-copy" data-reveal>
                    <span class="section-kicker light">Cotización técnica</span>
                    <h2>Qué necesitamos para cotizar</h2>
                    <p>Completá los datos disponibles. Si no conocés el modelo, abrí WhatsApp después de enviar el formulario y adjuntá una foto.</p>

                    <ol class="compat-data-list">
                        <li><span>01</span> Marca del equipo</li>
                        <li><span>02</span> Modelo o placa</li>
                        <li><span>03</span> Foto del repuesto o embrague</li>
                        <li><span>04</span> Cantidad necesaria</li>
                        <li><span>05</span> Localidad y provincia</li>
                    </ol>
                </div>

                <form class="compat-form" id="compatibility-form" data-reveal style="--i: 1">
                    <div class="compat-field">
                        <label for="brand">Marca del equipo</label>
                        <select id="brand" name="brand" required>
                            <option value="">Seleccionar</option>
                            <option value="Urvig">Urvig</option>
                            <option value="Micron">Micron</option>
                            <option value="Otro">Otro</option>
                        </select>
                    </div>
                    <div class="compat-field">
                        <label for="model">Modelo o placa</label>
                        <input id="model" name="model" type="text" placeholder="Ej: modelo, serie o no lo conozco" required>
                    </div>
                    <div class="compat-field">
                        <label for="quantity">Cantidad</label>
                        <input id="quantity" name="quantity" type="number" min="1" value="1" required>
                    </div>
                    <div class="compat-field">
                        <label for="location">Localidad / provincia</label>
                        <input id="location" name="location" type="text" placeholder="Ej: Río Cuarto, Córdoba" required>
                    </div>
                    <div class="compat-field compat-field-wide">
                        <label for="contact">Teléfono o WhatsApp</label>
                        <input id="contact" name="contact" type="tel" placeholder="Código de área + número" required>
                    </div>
                    <div class="compat-field compat-field-wide">
                        <label for="details">Detalle adicional</label>
                        <textarea id="details" name="details" rows="3" placeholder="Aplicación, medidas o descripción del repuesto"></textarea>
                    </div>
                    <button id="lead-form-submit" data-event="lead_form_submitted" class="btn btn-gold compat-submit" type="submit">
                        <i class="ph-bold ph-whatsapp-logo"></i>
                        Enviar consulta por WhatsApp
                    </button>
                    <p class="compat-form-note">Al continuar se abrirá WhatsApp con los datos cargados. Podrás adjuntar la foto antes de enviar.</p>
                </form>
            </div>
        </section>

        <section class="compat-contact section">
            <div class="container compat-contact-grid">
                <div data-reveal>
                    <span class="section-kicker">Respuesta directa</span>
                    <h2 class="section-title">Hablemos de tu equipo</h2>
                    <p class="section-subtitle">Nuestro equipo revisa la información técnica para confirmar compatibilidad, disponibilidad o posibilidad de fabricación.</p>
                </div>
                <div class="compat-contact-actions" data-reveal style="--i: 1">
                    <a
                        id="cta-whatsapp-final"
                        class="btn btn-primary js-track-whatsapp"
                        data-event="whatsapp_clicked"
                        data-location="final"
                        href={`${whatsappBase}?text=${encodeURIComponent('Hola ANGO, quiero consultar compatibilidad y disponibilidad de un repuesto.')}`}
                        target="_blank"
                        rel="noopener noreferrer"
                    ><i class="ph-bold ph-whatsapp-logo"></i> Pedir precio por WhatsApp</a>
                    <a id="cta-phone" class="btn btn-outline js-track-phone" data-event="phone_clicked" href="tel:+5493571699006"><i class="ph-bold ph-phone"></i> Llamar a ANGO</a>
                    <a id="cta-email" class="compat-email js-track-email" data-event="email_clicked" href="mailto:contacto@angometalurgica.com.ar">contacto@angometalurgica.com.ar</a>
                </div>
            </div>
        </section>

        <section class="compat-disclaimer">
            <div class="container">
                <p><strong>Aclaración de compatibilidad:</strong> Los nombres Urvig y Micron se utilizan únicamente para identificar compatibilidad. ANGO fabrica y comercializa soluciones compatibles; no se presenta como representante oficial salvo indicación expresa.</p>
            </div>
        </section>
    </main>

    <a
        id="cta-whatsapp-mobile"
        class="compat-mobile-cta js-track-whatsapp"
        data-event="whatsapp_clicked"
        data-location="mobile_sticky"
        href={`${whatsappBase}?text=${encodeURIComponent('Hola ANGO, necesito consultar compatibilidad de un repuesto Urvig/Micron.')}`}
        target="_blank"
        rel="noopener noreferrer"
    ><i class="ph-fill ph-whatsapp-logo"></i> Consultar compatibilidad</a>

    <Footer />
</Layout>

<script>
    const conversionElements = document.querySelectorAll<HTMLElement>('[data-event]');
    const searchParams = new URLSearchParams(window.location.search);
    const utmSource = searchParams.get('utm_source');
    const utmCampaign = searchParams.get('utm_campaign');

    conversionElements.forEach((element) => {
        element.addEventListener('click', () => {
            window.dispatchEvent(new CustomEvent('ango:conversion-intent', {
                detail: {
                    event: element.dataset.event,
                    location: element.dataset.location ?? 'not_set',
                    utm_source: utmSource,
                    utm_campaign: utmCampaign
                }
            }));
        });
    });

    const form = document.querySelector<HTMLFormElement>('#compatibility-form');

    form?.addEventListener('submit', (event) => {
        event.preventDefault();

        const data = new FormData(form);
        const messageLines = [
            'Hola ANGO, necesito cotizar un repuesto compatible.',
            '',
            `Marca: ${data.get('brand') ?? ''}`,
            `Modelo o placa: ${data.get('model') ?? ''}`,
            `Cantidad: ${data.get('quantity') ?? ''}`,
            `Localidad / provincia: ${data.get('location') ?? ''}`,
            `Contacto: ${data.get('contact') ?? ''}`,
            `Detalle: ${data.get('details') || 'Sin detalle adicional'}`,
            '',
            'Voy a adjuntar una foto para revisar compatibilidad.'
        ];

        if (utmSource || utmCampaign) {
            messageLines.push('', `Origen: ${utmSource ?? 'directo'} / ${utmCampaign ?? 'sin campaña'}`);
        }

        window.dispatchEvent(new CustomEvent('ango:conversion-intent', {
            detail: {
                event: 'lead_form_submitted',
                location: 'compatibility_form',
                utm_source: utmSource,
                utm_campaign: utmCampaign
            }
        }));

        window.open(`https://wa.me/5493571699006?text=${encodeURIComponent(messageLines.join('\n'))}`, '_blank', 'noopener,noreferrer');
    });
</script>

<style>
    :global(.wa-fab) { display: none !important; }

    .compat-page {
        background: var(--color-surface);
        overflow: hidden;
        padding-top: 76px;
    }

    .compat-hero {
        background:
            radial-gradient(circle at 75% 38%, rgba(0, 87, 184, 0.12), transparent 26%),
            linear-gradient(135deg, #fff 0%, var(--color-surface-soft) 100%);
        min-height: 760px;
        overflow: hidden;
        position: relative;
    }

    .compat-grid,
    .compat-quote-grid {
        background-image:
            linear-gradient(rgba(6, 40, 70, 0.055) 1px, transparent 1px),
            linear-gradient(90deg, rgba(6, 40, 70, 0.055) 1px, transparent 1px);
        background-size: 28px 28px;
        inset: 0;
        pointer-events: none;
        position: absolute;
    }

    .compat-hero-inner {
        align-items: center;
        display: grid;
        gap: 48px;
        min-height: 760px;
        padding-bottom: 70px;
        padding-top: 70px;
        position: relative;
        z-index: 1;
    }

    .compat-hero-copy h1 {
        color: var(--color-dark);
        font-family: var(--font-heading);
        font-size: clamp(43px, 6vw, 82px);
        font-weight: 900;
        letter-spacing: -0.045em;
        line-height: 0.95;
        margin-bottom: 26px;
        max-width: 820px;
        text-transform: uppercase;
    }

    .compat-hero-copy h1::after {
        color: var(--color-yellow);
        content: ".";
    }

    .compat-lead {
        color: #334155;
        font-size: clamp(17px, 2vw, 20px);
        line-height: 1.65;
        max-width: 680px;
    }

    .compat-hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        margin-top: 34px;
    }

    .compat-proof-list {
        display: flex;
        flex-wrap: wrap;
        gap: 15px 24px;
        list-style: none;
        margin-top: 30px;
    }

    .compat-proof-list li {
        align-items: center;
        color: var(--color-dark);
        display: flex;
        font-family: var(--font-mono);
        font-size: 12px;
        font-weight: 700;
        gap: 7px;
        text-transform: uppercase;
    }

    .compat-proof-list i { color: var(--color-primary); }

    .compat-hero-visual {
        border: 1px solid rgba(6, 40, 70, 0.24);
        min-height: 500px;
        position: relative;
    }

    .compat-hero-visual::before {
        border-left: 16px solid var(--color-yellow);
        border-top: 16px solid var(--color-yellow);
        content: '';
        height: 58px;
        left: -1px;
        position: absolute;
        top: -1px;
        width: 58px;
        z-index: 3;
    }

    .compat-figure-label {
        color: var(--color-ink-secondary);
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 700;
        left: 28px;
        letter-spacing: .08em;
        position: absolute;
        top: 26px;
        z-index: 3;
    }

    .compat-hero-image-wrap {
        inset: 58px 44px 72px;
        overflow: hidden;
        position: absolute;
    }

    .compat-hero-image {
        height: 100%;
        object-fit: cover;
        width: 100%;
    }

    .compat-callout {
        align-items: center;
        background: rgba(255,255,255,.95);
        border-left: 3px solid var(--color-primary);
        box-shadow: 0 12px 25px rgba(3,26,47,.14);
        display: flex;
        gap: 10px;
        padding: 11px 14px;
        position: absolute;
        z-index: 4;
    }

    .compat-callout span {
        color: var(--color-primary);
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 700;
    }

    .compat-callout strong {
        color: var(--color-dark);
        font-size: 12px;
        text-transform: uppercase;
    }

    .compat-callout-model { right: 2%; top: 25%; }
    .compat-callout-photo { bottom: 20%; left: 2%; }

    .compat-hero-stamp {
        bottom: 20px;
        display: grid;
        gap: 2px;
        position: absolute;
        right: 24px;
        text-align: right;
    }

    .compat-hero-stamp small {
        color: var(--color-primary);
        font-family: var(--font-mono);
        font-size: 8px;
        letter-spacing: .08em;
    }

    .compat-hero-stamp strong {
        color: var(--color-dark);
        font-size: 11px;
    }

    .compat-band { background: var(--color-dark); }

    .compat-band-grid {
        display: grid;
        padding-bottom: 22px;
        padding-top: 22px;
    }

    .compat-band-grid div {
        align-items: center;
        border-bottom: 1px solid rgba(255,255,255,.12);
        display: flex;
        gap: 13px;
        padding: 15px 0;
    }

    .compat-band-grid div:last-child { border-bottom: 0; }
    .compat-band-grid span { color: var(--color-yellow); font-family: var(--font-mono); font-size: 11px; }
    .compat-band-grid strong { color: #fff; font-size: 12px; text-transform: uppercase; }

    .compat-section-heading {
        display: grid;
        gap: 24px;
        margin-bottom: 42px;
    }

    .compat-line-grid { display: grid; gap: 24px; }

    .compat-line-card {
        background: #fff;
        border: 1px solid var(--color-border);
        border-top: 4px solid var(--color-primary);
        display: grid;
        overflow: hidden;
    }

    .compat-card-image {
        background: var(--color-surface-soft);
        min-height: 300px;
        overflow: hidden;
        position: relative;
    }

    .compat-card-image img {
        height: 100%;
        inset: 0;
        object-fit: cover;
        position: absolute;
        transition: transform .5s var(--ease-out);
        width: 100%;
    }

    .compat-line-card:hover .compat-card-image img { transform: scale(1.025); }

    .compat-card-image span {
        background: var(--color-dark);
        bottom: 0;
        color: var(--color-yellow);
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 700;
        left: 0;
        letter-spacing: .07em;
        padding: 10px 14px;
        position: absolute;
        z-index: 2;
    }

    .compat-card-body { padding: 30px; position: relative; }
    .compat-card-number { color: var(--color-yellow); font-family: var(--font-mono); font-size: 12px; font-weight: 700; }

    .compat-card-body h3 {
        color: var(--color-dark);
        font-family: var(--font-heading);
        font-size: clamp(25px, 3vw, 38px);
        font-weight: 900;
        line-height: 1;
        margin: 12px 0 16px;
        text-transform: uppercase;
    }

    .compat-card-body p { color: #475569; line-height: 1.65; margin-bottom: 24px; }

    .compat-text-link {
        align-items: center;
        color: var(--color-primary);
        display: inline-flex;
        font-size: 13px;
        font-weight: 900;
        gap: 8px;
        text-decoration: none;
        text-transform: uppercase;
    }

    .compat-parts { background: var(--color-surface-soft); }
    .compat-parts-heading { margin-bottom: 40px; max-width: 850px; }
    .compat-parts-heading .section-title { margin-bottom: 20px; }
    .compat-parts-grid { display: grid; gap: 18px; }

    .compat-parts-grid figure {
        background: #fff;
        border: 1px solid var(--color-border);
        margin: 0;
        overflow: hidden;
    }

    .compat-parts-grid img { aspect-ratio: 4/3; object-fit: cover; width: 100%; }

    .compat-parts-grid figcaption {
        color: var(--color-dark);
        font-size: 13px;
        font-weight: 900;
        padding: 18px;
        text-transform: uppercase;
    }

    .compat-parts-grid figcaption span { color: var(--color-primary); font-family: var(--font-mono); margin-right: 10px; }

    .compat-quote {
        background:
            radial-gradient(circle at 15% 25%, rgba(0,87,184,.2), transparent 28%),
            var(--color-dark);
        color: #fff;
        overflow: hidden;
        padding: 84px 0;
        position: relative;
    }

    .compat-quote-grid { opacity: .35; }
    .compat-quote-inner { display: grid; gap: 48px; position: relative; z-index: 1; }

    .compat-quote-copy h2 {
        font-family: var(--font-heading);
        font-size: clamp(38px, 5vw, 68px);
        font-weight: 900;
        line-height: .96;
        margin-bottom: 22px;
        text-transform: uppercase;
    }

    .compat-quote-copy h2::after { color: var(--color-yellow); content: '.'; }
    .compat-quote-copy > p { color: rgba(255,255,255,.7); line-height: 1.65; max-width: 640px; }

    .compat-data-list { display: grid; gap: 0; list-style: none; margin-top: 34px; }

    .compat-data-list li {
        border-top: 1px solid rgba(255,255,255,.12);
        color: rgba(255,255,255,.88);
        font-size: 13px;
        font-weight: 800;
        padding: 14px 0;
        text-transform: uppercase;
    }

    .compat-data-list span { color: var(--color-yellow); font-family: var(--font-mono); font-size: 10px; margin-right: 13px; }

    .compat-form {
        background: rgba(255,255,255,.055);
        border: 1px solid rgba(255,255,255,.14);
        border-top: 4px solid var(--color-yellow);
        display: grid;
        gap: 18px;
        padding: clamp(24px, 4vw, 40px);
    }

