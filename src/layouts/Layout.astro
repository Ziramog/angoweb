---
import '../styles/design-system.css';
import '../styles/components.css';
import '../styles/navbar.css';
import '../styles/hero.css';
import '../styles/sections.css';
import '../styles/footer.css';
import '../styles/styles.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const {
  title,
  description = 'Tomas de fuerza con embrague para transmisión de potencia industrial.',
  canonical
} = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:type" content="website">
    {canonical && <meta property="og:url" content={canonical} />}
    <script defer src="https://unpkg.com/@phosphor-icons/web"></script>
</head>
<body>
    <slot />
    
    <a href="https://wa.me/5493571699006" class="wa-fab" id="wa-fab" aria-label="Contactar por WhatsApp" target="_blank" rel="noopener noreferrer">
        <i class="ph-fill ph-whatsapp-logo"></i>
    </a>
    
    <script>
        import '../scripts/script.js';
    </script>
</body>
</html>
