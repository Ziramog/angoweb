---
<section class="spares-section" id="repuestos">
    <div class="container">
        <div class="spares-header">
            <div class="section-kicker dark" data-reveal>Soporte y Mantenimiento</div>
            <h2 class="section-title" data-reveal style="--i: 1">
                <span class="desktop-title">Repuestos y Reacondicionamiento</span>
                <span class="mobile-title">Repuestos</span>
            </h2>
            <p class="section-subtitle" data-reveal style="--i: 2">Alargamos la vida &uacute;til de sus equipos con repuestos originales y servicio t&eacute;cnico especializado para embragues RG, Urvig y Micron.</p>
        </div>

        <div class="spares-core-services" data-reveal style="--i: 3">
            <div class="core-service">
                <div class="core-service-icon">
                    <i class="ph-fill ph-gear"></i>
                </div>
                <div>
                    <h3>Repuestos L&iacute;nea RG</h3>
                    <p>Contamos con toda la l&iacute;nea de repuestos originales para embragues RG. Garantizamos disponibilidad, calce perfecto y durabilidad prolongada para sus equipos en operaci&oacute;n.</p>
                </div>
            </div>
            <div class="core-service">
                <div class="core-service-icon">
                    <i class="ph-fill ph-wrench"></i>
                </div>
                <div>
                    <h3>Reacondicionamiento a Nuevo</h3>
                    <p>Traiga su equipo desgastado. Nuestro equipo de t&eacute;cnicos expertos desarma, eval&uacute;a y reacondiciona sus embragues viejos para dejarlos funcionando como nuevos, con garant&iacute;a.</p>
                </div>
            </div>
        </div>

        <div class="spares-gallery-header" data-reveal style="--i: 4">
            <h3>Repuestos Urvig y Micron</h3>
            <p>Ofrecemos una amplia gama de repuestos compatibles con embragues de las marcas Urvig y Micron.</p>
        </div>

        <div class="spares-photo-gallery">
            <!-- Card 1 -->
            <div class="photo-card" data-reveal style="--i: 5">
                <div class="photo-card-img-wrapper">
                    <img src="/platoconcono_urvig.jpeg" alt="Plato con cono Urvig">
                </div>
                <div class="photo-card-content">
                    <h3>Plato con Cono</h3>
                    <p>Repuestos compatibles de alta precisi&oacute;n para sistemas Urvig y Micron.</p>
                </div>
            </div>
            
            <!-- Card 2 -->
            <div class="photo-card" data-reveal style="--i: 6">
                <div class="photo-card-img-wrapper">
                    <img src="/platodesplazable_urvig.jpeg" alt="Plato desplazable Urvig">
                </div>
                <div class="photo-card-content">
                    <h3>Plato Desplazable</h3>
                    <p>M&aacute;xima resistencia al desgaste y ajuste perfecto garantizado.</p>
                </div>
            </div>

            <!-- Card 3 -->
            <div class="photo-card" data-reveal style="--i: 7">
                <div class="photo-card-img-wrapper">
                    <img src="/portacollar_urvig.jpeg" alt="Portacollar Urvig">
                </div>
                <div class="photo-card-content">
                    <h3>Portacollar</h3>
                    <p>Componentes mecanizados bajo estrictos est&aacute;ndares de calidad.</p>
                </div>
            </div>
        </div>

        <div class="spares-cta" data-reveal style="--i: 8">
            <a href="https://wa.me/543513157202?text=Hola,%20quisiera%20consultar%20por%20repuestos%20o%20reparaci%C3%B3n%20de%20embragues." target="_blank" class="btn btn-primary">
                <i class="ph-bold ph-whatsapp-logo"></i> Consultar disponibilidad
            </a>
        </div>
    </div>
</section>

<style>
    .spares-section {
        background-color: #F8FAFC;
        padding: 80px 0;
        border-top: 1px solid var(--color-border);
        border-bottom: 1px solid var(--color-border);
    }

    .spares-header {
        text-align: center;
        margin-bottom: 50px;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .spares-header .section-subtitle {
        margin: 16px auto 0;
    }

    .mobile-title {
        display: none;
    }

    @media (max-width: 767px) {
        .desktop-title { display: none; }
        .mobile-title { display: inline; }
    }

    /* Core Services */
    .spares-core-services {
        display: grid;
        grid-template-columns: 1fr;
        gap: 32px;
        margin-bottom: 60px;
        background: #fff;
        padding: 40px;
        border-radius: 12px;
        border: 1px solid var(--color-border);
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
    }

    .core-service {
        display: flex;
        flex-direction: column;
        gap: 20px;
        align-items: flex-start;
    }

    .core-service-icon {
        width: 60px;
        height: 60px;
        background: rgba(0, 87, 184, 0.08);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .core-service-icon i {
        font-size: 28px;
        color: var(--color-primary);
    }

    .core-service h3 {
        color: var(--color-dark);
        font-family: var(--font-heading);
        font-size: 22px;
        margin-bottom: 12px;
        font-stretch: 75%;
    }

    .core-service p {
        color: #475569;
        line-height: 1.6;
        font-size: 16px;
        margin: 0;
    }

    @media (min-width: 768px) {
        .spares-core-services {
            grid-template-columns: 1fr 1fr;
            gap: 48px;
            padding: 50px;
        }
        .core-service {
            flex-direction: row;
        }
    }

    /* Gallery Header */
    .spares-gallery-header {
        text-align: center;
        margin-bottom: 32px;
    }

    .spares-gallery-header h3 {
        color: var(--color-dark);
        font-family: var(--font-heading);
        font-size: 28px;
        margin-bottom: 12px;
        font-stretch: 75%;
        text-transform: uppercase;
    }

    .spares-gallery-header p {
        color: #475569;
        font-size: 16px;
    }

    /* Photo Gallery */
    .spares-photo-gallery {
        display: grid;
        grid-template-columns: 1fr;
        gap: 24px;
        margin-bottom: 50px;
    }

    .photo-card {
        background: #fff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.06);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border: 1px solid var(--color-border);
    }

    .photo-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
    }

    .photo-card-img-wrapper {
        width: 100%;
        height: 240px;
        overflow: hidden;
        position: relative;
        background: #f1f5f9;
    }

    .photo-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s ease;
    }

    .photo-card:hover img {
        transform: scale(1.05);
    }

    .photo-card-content {
        padding: 24px;
        border-top: 1px solid var(--color-border);
    }

    .photo-card h3 {
        font-size: 18px;
        font-family: var(--font-heading);
        margin-bottom: 8px;
        color: var(--color-dark);
        text-transform: uppercase;
        font-stretch: 75%;
    }

    .photo-card p {
        font-size: 14px;
        color: #475569;
        margin: 0;
        line-height: 1.5;
    }

    @media (min-width: 768px) {
        .spares-photo-gallery {
            grid-template-columns: repeat(3, 1fr);
            gap: 32px;
        }
    }

    .spares-cta {
        text-align: center;
    }
</style>
