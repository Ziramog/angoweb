---
---
<div class="specs-band">
    <div class="container specs-band-inner">
        <div class="spec-item">
            <i class="ph ph-gear"></i>
            <div><span>CARCAZAS</span><strong>SAE 6 &ndash; 00</strong></div>
        </div>
        <div class="spec-divider"></div>
        <div class="spec-item">
            <i class="ph ph-disc"></i>
            <div><span>DISCOS DE FRICCI&Oacute;N</span><strong>1, 2 Y 3</strong></div>
        </div>
        <div class="spec-divider"></div>
        <div class="spec-item">
            <i class="ph ph-ruler"></i>
            <div><span>DI&Aacute;METRO</span><strong>&Oslash;165 &ndash; 457 mm</strong></div>
        </div>
        <div class="spec-divider"></div>
        <div class="spec-item">
            <i class="ph ph-wrench"></i>
            <div><span>TORQUE</span><strong>HASTA 12.000 Nm</strong></div>
        </div>
        <div class="spec-divider mobile-hidden"></div>
        <div class="spec-item mobile-hidden">
            <i class="ph ph-shield-check"></i>
            <div><span>CONSTRUCCI&Oacute;N</span><strong>INDUSTRIAL PESADA</strong></div>
        </div>
    </div>
</div>

<section class="selection-section" id="especificaciones">
    <div class="container selection-inner">
        <div class="selection-blueprint" data-reveal>
            <img src="/plano.png" alt="Plano técnico" class="blueprint-img">
        </div>

        <div class="selection-content">
            <div class="section-kicker light" data-reveal>Ingenier&iacute;a aplicada</div>
            <h2 class="selection-title" data-reveal style="--i: 1">&iexcl;Calculemos tu toma de fuerza!</h2>
            <p class="selection-copy" data-reveal style="--i: 2">Para definir la toma de fuerza correcta, necesitamos que nos env&iacute;es estos 3 datos fundamentales:</p>

            <form id="tomaFuerzaForm" class="selection-form" data-reveal style="--i: 3">
                <div class="form-group">
                    <label for="motor">01. Motor y potencia (HP / CV)</label>
                    <input type="text" id="motor" placeholder="Ej: Scania 450 HP" required />
                </div>
                <div class="form-group">
                    <label for="rpm">02. RPM de trabajo (VAC / MAX)</label>
                    <input type="number" id="rpm" placeholder="Ej: 1800" required />
                </div>
                <div class="form-group">
                    <label for="uso">03. Uso destinado que se le dar&aacute;</label>
                    <select id="uso" required>
                        <option value="">&mdash; Seleccionar equipo &mdash;</option>
                        <option value="Bomba centr&iacute;fuga">Bomba centr&iacute;fuga</option>
                        <option value="Tracto agr&iacute;cola">Tracto agr&iacute;cola</option>
                        <option value="Bomba alternativa">Bomba alternativa</option>
                        <option value="Bomba de fango o barro">Bomba de fango o barro</option>
                        <option value="M&aacute;quina trituradora de rocas">M&aacute;quina trituradora de rocas</option>
                        <option value="Compresor alternativo">Compresor alternativo</option>
                        <option value="Ventilador">Ventilador</option>
                        <option value="Otro">Otro (Especificar en comentarios)</option>
                    </select>
                </div>

                <div class="form-group" style="grid-column: 1 / -1;">
                    <label for="comentarios">04. Comentarios adicionales (Opcional)</label>
                    <textarea id="comentarios" placeholder="Detalles adicionales, marca del motor, etc." rows="2"></textarea>
                </div>

                <div class="selection-actions">
                    <button type="submit" class="btn btn-gold selection-cta"><i class="ph ph-paper-plane-tilt"></i> Enviar datos</button>
                    <div style="text-align: center; margin-top: 15px;">
                        <a href="/calculadora" class="selection-alt-link" style="color: rgba(255, 255, 255, 0.7); font-size: 14px; text-decoration: underline;">o usar calculadora</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const form = document.getElementById("tomaFuerzaForm");
        if (!form) return;

        form.addEventListener("submit", (e) => {
            e.preventDefault();
            
            const motor = document.getElementById("motor").value;
            const rpm = document.getElementById("rpm").value;
            const uso = document.getElementById("uso").value;
            const comentarios = document.getElementById("comentarios").value;
            
            const isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);
            
            let mensaje = `Hola, necesito asesoramiento para una toma de fuerza.\n\nMis datos son:\n- Motor y potencia: ${motor}\n- RPM de trabajo: ${rpm}\n- Uso destinado: ${uso}`;
            if (comentarios.trim() !== '') {
                mensaje += `\n- Comentarios: ${comentarios}`;
            }
            
            if (isMobile) {
                // WhatsApp
                const telefono = "5491112345678"; 
                const url = `https://wa.me/${telefono}?text=${encodeURIComponent(mensaje)}`;
                window.open(url, '_blank');
            } else {
                // Email
                const email = "info@angometalurgica.com.ar";
                const subject = "Consulta Técnica: Selección de Toma de Fuerza";
                const body = encodeURIComponent(mensaje);
                window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
            }
        });
    });
</script>
