---
---
<section class="section applications-section" id="aplicaciones">
    <div class="container">
        <div class="section-kicker" data-reveal>Aplicaciones</div>
        <div class="section-heading-row">
            <h2 class="section-title" data-reveal>Industriales</h2>
            <p class="section-subtitle" data-reveal style="--i: 1">Soluciones confiables para equipos de combusti&oacute;n interna di&eacute;sel o nafteros, con configuraciones de 1, 2 o 3 discos.</p>
        </div>

        <div class="apps-grid" data-reveal style="--i: 2">
            <!-- Sector 1: Agricultura y Silvicultura -->
            <article class="app-module has-hover-list">
                <div class="app-header">
                    <i class="ph-fill ph-tractor app-icon"></i>
                    <h3>Agricultura & Silvicultura</h3>
                </div>
                <div class="app-hover-content">
                    <ul>
                        <li><i class="ph-bold ph-caret-right"></i> Implementos agr&iacute;colas</li>
                        <li><i class="ph-bold ph-caret-right"></i> Tractores</li>
                        <li><i class="ph-bold ph-caret-right"></i> Cosechadoras</li>
                        <li><i class="ph-bold ph-caret-right"></i> Maquinaria forestal</li>
                        <li><i class="ph-bold ph-caret-right"></i> Bombas de riego</li>
                        <li><i class="ph-bold ph-caret-right"></i> Empacadoras</li>
                        <li><i class="ph-bold ph-caret-right"></i> Ensiladoras</li>
                        <li><i class="ph-bold ph-caret-right"></i> Picadoras y Sopladoras</li>
                        <li><i class="ph-bold ph-caret-right"></i> Agitadores</li>
                        <li><i class="ph-bold ph-caret-right"></i> Astilladoras</li>
                        <li><i class="ph-bold ph-caret-right"></i> Trituradoras y Aserraderos de madera</li>
                    </ul>
                </div>
                <div class="app-photo-container">
                    <img src="/tractor.png" alt="Agricultura" class="app-photo">
                </div>
            </article>

            <!-- Sector 2: Saneamiento y Bombeo -->
            <article class="app-module has-hover-list">
                <div class="app-header">
                    <i class="ph-fill ph-drop app-icon"></i>
                    <h3>Saneamiento & Bombeo</h3>
                </div>
                <div class="app-hover-content">
                    <ul>
                        <li><i class="ph-bold ph-caret-right"></i> Bombas centr&iacute;fugas</li>
                        <li><i class="ph-bold ph-caret-right"></i> Sistemas de alcantarillado</li>
                        <li><i class="ph-bold ph-caret-right"></i> Tratamiento de aguas</li>
                        <li><i class="ph-bold ph-caret-right"></i> Equipos de Hidroarenado (Alta Presi&oacute;n)</li>
                        <li><i class="ph-bold ph-caret-right"></i> Aspiraci&oacute;n de Polvo</li>
                        <li><i class="ph-bold ph-caret-right"></i> Hidrochorro + Vac&iacute;o</li>
                        <li><i class="ph-bold ph-caret-right"></i> Motobomba Hidrojet</li>
                    </ul>
                </div>
                <div class="app-photo-container">
                    <img src="/bomba.png" alt="Bombas" class="app-photo">
                </div>
            </article>

            <!-- Sector 3: Industria General -->
            <article class="app-module has-hover-list">
                <div class="app-header">
                    <i class="ph-fill ph-factory app-icon"></i>
                    <h3>Industria & Reciclaje</h3>
                </div>
                <div class="app-hover-content">
                    <ul>
                        <li><i class="ph-bold ph-caret-right"></i> Compresores</li>
                        <li><i class="ph-bold ph-caret-right"></i> Ventiladores industriales</li>
                        <li><i class="ph-bold ph-caret-right"></i> Generadores</li>
                        <li><i class="ph-bold ph-caret-right"></i> Plantas de reciclaje</li>
                        <li><i class="ph-bold ph-caret-right"></i> Recicladoras</li>
                        <li><i class="ph-bold ph-caret-right"></i> Trituradoras industriales</li>
                    </ul>
                </div>
                <div class="app-photo-container">
                    <img src="/compresor.png" alt="Industria General" class="app-photo">
                </div>
            </article>

            <!-- Sector 4: Construcción y Minería -->
            <article class="app-module has-hover-list">
                <div class="app-header">
                    <i class="ph-fill ph-truck app-icon"></i>
                    <h3>Construcci&oacute;n & Miner&iacute;a</h3>
                </div>
                <div class="app-hover-content">
                    <ul>
                        <li><i class="ph-bold ph-caret-right"></i> Equipos especiales</li>
                        <li><i class="ph-bold ph-caret-right"></i> Gr&uacute;as y excavadoras</li>
                        <li><i class="ph-bold ph-caret-right"></i> Trituradoras de piedra y roca</li>
                        <li><i class="ph-bold ph-caret-right"></i> Extracci&oacute;n minera</li>
                        <li><i class="ph-bold ph-caret-right"></i> Martillos pil&oacute;n y Perforadoras</li>
                        <li><i class="ph-bold ph-caret-right"></i> Pavimentadoras y Fresadoras</li>
                        <li><i class="ph-bold ph-caret-right"></i> Bombas de dragado (arena y grava)</li>
                        <li><i class="ph-bold ph-caret-right"></i> Dragalinas</li>
                    </ul>
                </div>
                <div class="app-photo-container">
                    <img src="/equipo-especial.png" alt="Construcción y Minería" class="app-photo">
                </div>
            </article>

            <!-- Sector 5: Petróleo, Gas y Energía -->
            <article class="app-module has-hover-list">
                <div class="app-header">
                    <i class="ph-fill ph-lightning app-icon"></i>
                    <h3>Petr&oacute;leo & Energ&iacute;a</h3>
                </div>
                <div class="app-hover-content">
                    <ul>
                        <li><i class="ph-bold ph-caret-right"></i> Generadores alta capacidad</li>
                        <li><i class="ph-bold ph-caret-right"></i> Torres de perforaci&oacute;n</li>
                        <li><i class="ph-bold ph-caret-right"></i> Equipos de refiner&iacute;a</li>
                    </ul>
                </div>
                <div class="app-photo-container">
                    <img src="/generador.png" alt="Petróleo y Energía" class="app-photo">
                </div>
            </article>

            <!-- Sector 6: Sector Naval -->
            <article class="app-module has-hover-list">
                <div class="app-header">
                    <i class="ph-fill ph-anchor app-icon"></i>
                    <h3>Sector Mar&iacute;timo / Naval</h3>
                </div>
                <div class="app-hover-content">
                    <ul>
                        <li><i class="ph-bold ph-caret-right"></i> Propulsi&oacute;n naval</li>
                        <li><i class="ph-bold ph-caret-right"></i> Gr&uacute;as portuarias</li>
                        <li><i class="ph-bold ph-caret-right"></i> Embarcaciones comerciales</li>
                        <li><i class="ph-bold ph-caret-right"></i> Bombas contra incendios</li>
                        <li><i class="ph-bold ph-caret-right"></i> Bombas para barcazas</li>
                        <li><i class="ph-bold ph-caret-right"></i> Control de inundaciones y diques</li>
                        <li><i class="ph-bold ph-caret-right"></i> Bombas de dragado</li>
                    </ul>
                </div>
                <div class="app-photo-container">
                    <img src="/ventilador.png" alt="Sector Naval" class="app-photo">
                </div>
            </article>
        </div>
    </div>
</section>
