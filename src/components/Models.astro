<section class="models-section" id="modelos">
    <div class="container">
        <div class="models-header">
            <h2 class="section-title" data-reveal>Modelos y capacidades</h2>
            <p class="section-subtitle" data-reveal style="--i: 1">Cat&aacute;logo t&eacute;cnico de l&iacute;nea est&aacute;ndar. Para requisitos especiales, consulte a nuestro equipo de ingenier&iacute;a.</p>
        </div>

        <div class="models-content-grid">
            <div class="models-image-wrapper" data-reveal style="--i: 2">
                <img src="/embrague-corte-final.png" alt="Corte transversal embrague ANGO" class="models-img" style="max-width: 70%; margin: 0 auto; display: block;">
            </div>
            
            <div class="models-download-box" id="catalogo" data-reveal style="--i: 3">
                <div class="download-icon">
                    <i class="ph-fill ph-file-pdf"></i>
                </div>
                <h3>Ficha T&eacute;cnica</h3>
                <p>Descargue el documento completo con especificaciones, tabla de modelos, medidas y capacidades de torque.</p>
                <a href="/FICHA-TECNICA-PTO-RG.pdf" target="_blank" class="btn btn-primary" download>
                    <i class="ph-bold ph-download-simple"></i> Descargar PDF
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    .models-download-box {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        background: rgba(255, 255, 255, 0.84);
        border: 1px solid var(--color-border);
        border-top: 4px solid var(--color-primary);
        border-radius: 8px;
        padding: 40px;
        min-height: 300px;
    }
    
    .download-icon {
        background: rgba(0, 87, 184, 0.08); /* Fondo claro con color primario */
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 24px;
    }
    
    .download-icon i {
        font-size: 40px;
        color: var(--color-primary);
    }
    
    .models-download-box h3 {
        color: var(--color-dark);
        font-family: var(--font-heading);
        font-size: 28px;
        margin-bottom: 12px;
        text-transform: uppercase;
        font-stretch: 75%;
    }
    
    .models-download-box p {
        color: #334155;
        margin-bottom: 32px;
        max-width: 400px;
        line-height: 1.6;
        font-size: 16px;
    }
    
    .models-download-box .btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
</style>
