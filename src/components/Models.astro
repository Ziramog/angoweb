<section class="models-section" id="modelos">
    <div class="container">
        <div class="models-header">
            <h2 class="section-title" data-reveal>Modelos y capacidades</h2>
            <p class="section-subtitle" data-reveal style="--i: 1">Cat&aacute;logo t&eacute;cnico de l&iacute;nea est&aacute;ndar. Para requisitos especiales, consulte a nuestro equipo de ingenier&iacute;a.</p>
        </div>

        <div class="models-content-grid">
            <div class="models-image-wrapper" data-reveal style="--i: 2">
                <img src="/embrague-corte-final.png" alt="Corte transversal embrague ANGO" class="models-img" style="max-width: 70%; margin: 0 auto; display: block;">
            </div>
            
            <div class="models-download-box" id="catalogo" data-reveal style="--i: 3" style="display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 300px; border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; padding: 40px; text-align: center; background: linear-gradient(135deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0.01) 100%);">
                <div style="background: rgba(239, 184, 16, 0.1); width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 24px;">
                    <i class="ph-fill ph-file-pdf" style="font-size: 40px; color: var(--color-yellow);"></i>
                </div>
                <h3 style="color: #fff; font-family: var(--font-heading); font-size: 28px; margin-bottom: 12px; text-transform: uppercase; font-stretch: 75%;">Ficha T&eacute;cnica</h3>
                <p style="color: rgba(255,255,255,0.7); margin-bottom: 32px; max-width: 400px; line-height: 1.6;">Descargue el documento completo con especificaciones, tabla de modelos, medidas y capacidades de torque.</p>
                <a href="/FICHA-TECNICA-PTO-RG.pdf" target="_blank" class="btn btn-gold" download style="display: inline-flex; align-items: center; gap: 8px;">
                    <i class="ph-bold ph-download-simple"></i> Descargar PDF
                </a>
            </div>
    </div>
    </div>
</section>
