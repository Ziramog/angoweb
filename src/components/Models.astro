---
---
<section class="models-section models-showcase" id="modelos">
    <div class="models-grid-overlay" aria-hidden="true"></div>

    <div class="container models-showcase-grid">
        <div class="models-visual" data-reveal style="--i: 1">
            <div class="models-visual-frame">
                <span class="models-axis models-axis-x" aria-hidden="true"></span>
                <span class="models-axis models-axis-y" aria-hidden="true"></span>
                <span class="models-figure-index" aria-hidden="true">FIG. 01 / CORTE TÉCNICO</span>

                <img
                    src="/embrague-corte-final.png"
                    alt="Corte transversal de embrague industrial ANGO"
                    class="models-product-image"
                    loading="lazy"
                    decoding="async"
                >

                <div class="models-callout models-callout-sae">
                    <span>CARCAZAS</span>
                    <strong>SAE 6–00</strong>
                </div>
                <div class="models-callout models-callout-discs">
                    <span>CONFIGURACIÓN</span>
                    <strong>1, 2 Y 3 DISCOS</strong>
                </div>
                <div class="models-callout models-callout-torque">
                    <span>TORQUE MÁXIMO</span>
                    <strong>12.000 Nm</strong>
                </div>
            </div>
        </div>

        <div class="models-content">
            <div class="models-heading" data-reveal style="--i: 2">
                <span class="section-kicker">Línea de productos</span>
                <p class="models-category">Embragues industriales y tomas de fuerza (PTO)</p>
                <h2 class="section-title">Modelos y Capacidades</h2>
                <p class="section-subtitle">Explore nuestro catálogo técnico de línea estándar. Como fabricantes, desarrollamos soluciones a medida. Para requisitos especiales en transmisión de potencia, consulte a nuestro equipo de ingeniería.</p>
            </div>

            <div class="models-document" id="catalogo" data-reveal style="--i: 3">
                <div class="models-document-code" aria-hidden="true">
                    <span>DOC.</span>
                    <strong>RG/01</strong>
                </div>
                <div class="models-document-body">
                    <div class="models-document-label">
                        <i class="ph-fill ph-file-pdf"></i>
                        <span>Documentación técnica</span>
                    </div>
                    <h3>Catálogo Técnico RG</h3>
                    <p>Especificaciones, tabla de modelos, medidas y capacidades de torque para tomas de fuerza y embragues.</p>
                    <a href="/Catalogo_Tecnico_RG_ANGO.pdf" target="_blank" rel="noopener noreferrer" class="btn btn-primary" download>
                        <i class="ph-bold ph-download-simple"></i>
                        Descargar PDF
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .models-showcase {
        background:
            linear-gradient(180deg, rgba(3, 26, 47, 0.035), transparent 22%),
            var(--color-surface-soft);
        border-top: 1px solid rgba(6, 40, 70, 0.18);
        overflow: hidden;
        position: relative;
    }

    .models-grid-overlay {
        background-image:
            linear-gradient(rgba(6, 40, 70, 0.045) 1px, transparent 1px),
            linear-gradient(90deg, rgba(6, 40, 70, 0.045) 1px, transparent 1px);
        background-size: 28px 28px;
        inset: 0;
        mask-image: linear-gradient(90deg, #000, rgba(0, 0, 0, 0.18) 72%, transparent);
        opacity: 0.9;
        pointer-events: none;
        position: absolute;
    }

    .models-showcase-grid {
        display: grid;
        gap: 44px;
        position: relative;
        z-index: 1;
    }

    .models-visual-frame {
        align-items: center;
        aspect-ratio: 1 / 0.9;
        border: 1px solid rgba(6, 40, 70, 0.26);
        display: flex;
        justify-content: center;
        min-height: 430px;
        overflow: hidden;
        position: relative;
    }

    .models-visual-frame::before,
    .models-visual-frame::after {
        content: "";
        pointer-events: none;
        position: absolute;
    }

    .models-visual-frame::before {
        border-left: 16px solid var(--color-yellow);
        border-top: 16px solid var(--color-yellow);
        height: 58px;
        left: -1px;
        top: -1px;
        width: 58px;
    }

    .models-visual-frame::after {
        border-bottom: 1px solid rgba(6, 40, 70, 0.22);
        border-right: 1px solid rgba(6, 40, 70, 0.22);
        bottom: 18px;
        height: 52px;
        right: 18px;
        width: 52px;
    }

    .models-axis {
        background: rgba(0, 87, 184, 0.12);
        pointer-events: none;
        position: absolute;
    }

    .models-axis-x {
        height: 1px;
        left: 5%;
        right: 5%;
        top: 50%;
    }

    .models-axis-y {
        bottom: 5%;
        left: 50%;
        top: 5%;
        width: 1px;
    }

    .models-figure-index {
        color: var(--color-ink-secondary);
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 700;
        left: 26px;
        letter-spacing: 0.08em;
        position: absolute;
        top: 24px;
    }

    .models-product-image {
        filter: drop-shadow(0 30px 28px rgba(3, 26, 47, 0.2));
        height: auto;
        max-width: min(72%, 600px);
        position: relative;
        transform: translate(-2%, 4%);
        z-index: 2;
    }

    .models-callout {
        background: rgba(255, 255, 255, 0.94);
        border-left: 3px solid var(--color-primary);
        box-shadow: 0 10px 24px rgba(3, 26, 47, 0.1);
        display: grid;
        gap: 3px;
        min-width: 132px;
        padding: 10px 12px;
        position: absolute;
        z-index: 3;
    }

    .models-callout span {
        color: var(--color-ink-secondary);
        font-family: var(--font-mono);
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.07em;
    }

    .models-callout strong {
        color: var(--color-dark);
        font-family: var(--font-heading);
        font-size: 13px;
        font-weight: 900;
    }

    .models-callout-sae {
        right: 5%;
        top: 16%;
    }

    .models-callout-discs {
        left: 4%;
        top: 43%;
    }

    .models-callout-torque {
        bottom: 10%;
        right: 8%;
    }

    .models-content {
        align-self: center;
        display: flex;
        flex-direction: column;
        gap: 34px;
    }

    .models-heading .section-kicker {
        margin-bottom: 14px;
    }

    .models-category {
        color: var(--color-primary);
        font-family: var(--font-mono);
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.04em;
        margin-bottom: 18px;
        max-width: 560px;
        text-transform: uppercase;
    }

    .models-heading .section-title {
        margin-bottom: 24px;
    }

    .models-heading .section-subtitle {
        max-width: 620px;
    }

    .models-document {
        background: var(--color-dark);
        border-top: 4px solid var(--color-yellow);
        color: var(--color-surface);
        display: grid;
        grid-template-columns: 92px 1fr;
        overflow: hidden;
    }

    .models-document-code {
        align-items: center;
        background: rgba(255, 255, 255, 0.055);
        border-right: 1px solid rgba(255, 255, 255, 0.12);
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 24px 12px;
    }

    .models-document-code span {
        color: rgba(255, 255, 255, 0.48);
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.08em;
    }

    .models-document-code strong {
        color: var(--color-yellow);
        font-family: var(--font-mono);
        font-size: 18px;
        margin-top: 5px;
    }

    .models-document-body {
        padding: 26px;
    }

    .models-document-label {
        align-items: center;
        color: var(--color-yellow);
        display: flex;
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 700;
        gap: 8px;
        letter-spacing: 0.06em;
        margin-bottom: 10px;
        text-transform: uppercase;
    }

    .models-document-label i {
        font-size: 18px;
    }

    .models-document h3 {
        font-family: var(--font-heading);
        font-size: 22px;
        font-weight: 900;
        line-height: 1.15;
        margin-bottom: 10px;
        text-transform: uppercase;
    }

    .models-document p {
        color: rgba(255, 255, 255, 0.7);
        font-size: 14px;
        line-height: 1.6;
        margin-bottom: 22px;
        max-width: 480px;
    }

    .models-document .btn {
        min-height: 48px;
    }

    @media (min-width: 1060px) {
        .models-showcase-grid {
            align-items: center;
            gap: clamp(52px, 6vw, 100px);
            grid-template-columns: minmax(0, 1.1fr) minmax(390px, 0.9fr);
        }
    }

    @media (max-width: 720px) {
        .models-showcase-grid {
            gap: 34px;
        }

        .models-content {
            display: contents;
        }

        .models-heading {
            grid-row: 1;
        }

        .models-visual {
            grid-row: 2;
        }

        .models-document {
            grid-row: 3;
        }

        .models-visual-frame {
            aspect-ratio: auto;
            min-height: 400px;
        }

        .models-product-image {
            max-width: 82%;
            transform: translateY(3%);
        }

        .models-callout {
            min-width: 116px;
            padding: 8px 10px;
        }

        .models-callout-discs {
            left: 3%;
            top: 48%;
        }

        .models-callout-torque {
            bottom: 7%;
        }

        .models-document {
            grid-template-columns: 68px 1fr;
        }

        .models-document-code {
            padding-inline: 8px;
        }

        .models-document-code strong {
            font-size: 14px;
        }

        .models-document-body {
            padding: 24px 20px;
        }
    }

    @media (max-width: 480px) {
        .models-visual-frame {
            min-height: 350px;
        }

        .models-callout {
            min-width: 104px;
        }

        .models-callout span {
            font-size: 8px;
        }

        .models-callout strong {
            font-size: 11px;
        }

        .models-callout-sae {
            right: 3%;
            top: 18%;
        }

        .models-callout-discs {
            left: 2%;
            top: 52%;
        }

        .models-callout-torque {
            bottom: 5%;
            right: 72px;
        }

        .models-document {
            display: block;
        }

        .models-document-code {
            align-items: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.12);
            border-right: 0;
            flex-direction: row;
            gap: 8px;
            justify-content: flex-start;
            padding: 12px 20px;
        }

        .models-document-code strong {
            margin-top: 0;
        }
    }
</style>
