<section class="models-section" id="modelos">
    <div class="container">
        <div class="models-header">
            <h2 class="section-title" data-reveal>Modelos y capacidades</h2>
            <p class="section-subtitle" data-reveal style="--i: 1">Cat&aacute;logo t&eacute;cnico de l&iacute;nea est&aacute;ndar. Para requisitos especiales, consulte a nuestro equipo de ingenier&iacute;a.</p>
        </div>

        <div class="models-content-grid">
            <div class="models-image-wrapper" data-reveal style="--i: 2">
                <img src="/embrague-corte-final.png" alt="Corte transversal embrague ANGO" class="models-img" style="max-width: 70%; margin: 0 auto; display: block;">
            </div>
            
            <div class="models-download-box" id="catalogo" data-reveal style="--i: 3">
                <div class="download-cover">
                    <img src="/portada_pdf.png" alt="Portada Ficha Técnica">
                </div>
                <div class="download-content">
                    <h3>Ficha T&eacute;cnica</h3>
                    <p>Descargue el documento completo con especificaciones, tabla de modelos, medidas y capacidades de torque.</p>
                    <a href="/FICHA-TECNICA-PTO-RG.pdf" target="_blank" class="btn btn-gold" download>
                        <i class="ph-bold ph-download-simple"></i> Descargar PDF
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .models-download-box {
        display: flex;
        flex-direction: column;
        background: linear-gradient(135deg, rgba(4, 29, 51, 0.9) 0%, rgba(2, 17, 32, 0.95) 100%);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }
    
    .download-cover {
        background: #020d18;
        padding: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .download-cover img {
        max-width: 140px;
        border-radius: 4px;
        box-shadow: 0 8px 16px rgba(0,0,0,0.5);
        transition: transform 0.3s ease;
    }
    
    .models-download-box:hover .download-cover img {
        transform: translateY(-5px);
    }
    
    .download-content {
        padding: 30px;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }
    
    .download-content h3 {
        color: #fff;
        font-family: var(--font-heading);
        font-size: 24px;
        margin-bottom: 12px;
        text-transform: uppercase;
        font-stretch: 75%;
    }
    
    .download-content p {
        color: rgba(255, 255, 255, 0.85);
        margin-bottom: 24px;
        line-height: 1.6;
        font-size: 15px;
    }
    
    .download-content .btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
    
    @media (min-width: 600px) {
        .models-download-box {
            flex-direction: row;
        }
        .download-cover {
            flex: 0 0 40%;
            padding: 30px 20px;
        }
        .download-content {
            flex: 1;
            text-align: left;
            align-items: flex-start;
            padding: 40px;
        }
    }
</style>
