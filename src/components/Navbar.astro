---
export interface Props {
    forceScrolled?: boolean;
}
const { forceScrolled = false } = Astro.props;
---
<header class={`navbar ${forceScrolled ? 'scrolled' : ''}`} id="main-header" data-force-scrolled={forceScrolled ? "true" : undefined}>
    <div class="container navbar-inner">
        <a href="/" class="navbar-logo-container" aria-label="ANGO Metalurgica">
            <img class="navbar-logo" src="/angologo512.png" alt="ANGO Metalurgica">
        </a>

        <nav class="nav-links" aria-label="Navegacion principal">
            <a href="/#aplicaciones" class="nav-link">Aplicaciones</a>
            <a href="/#especificaciones" class="nav-link">Presupuesto</a>
            <a href="/#modelos" class="nav-link">Modelos</a>
            <a href="/#repuestos" class="nav-link">Repuestos</a>
            <a href="/calculadora" class="nav-link">Calculadora</a>
        </nav>

        <button class="hamburger" id="mobile-menu-btn" aria-label="Abrir menu" aria-expanded="false" aria-controls="mobile-menu">
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
        </button>
    </div>

    <div class="mobile-menu" id="mobile-menu">
        <div class="mobile-menu-inner">
            <div class="mobile-menu-links">
                <a href="/#aplicaciones" class="mobile-menu-link"><span class="menu-link-prefix">/</span>Aplicaciones</a>
                <a href="/#especificaciones" class="mobile-menu-link"><span class="menu-link-prefix">/</span>Presupuesto</a>
                <a href="/#modelos" class="mobile-menu-link"><span class="menu-link-prefix">/</span>Modelos</a>
                <a href="/#repuestos" class="mobile-menu-link"><span class="menu-link-prefix">/</span>Repuestos</a>
                <a href="/calculadora" class="mobile-menu-link"><span class="menu-link-prefix">/</span>Calculadora</a>
            </div>
        </div>
    </div>
</header>
